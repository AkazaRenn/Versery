<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="View.Pages.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:controls="using:View.Controls"
    xmlns:vm.controls="using:ViewModel.Controls"
    NavigationCacheMode="Required">
    <ScrollView
        x:Name="ScrollView"
        VerticalScrollBarVisibility="Hidden"
        CornerRadius="0">
        <StackPanel
            Orientation="Vertical"
            MaxWidth="600">
            <ItemsRepeater
                ItemsSource="{x:Bind viewModel.Statuses}"
                ElementPrepared="ItemsRepeater_ElementPrepared"
                ElementIndexChanged="ItemsRepeater_ElementIndexChanged">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm.controls:Status">
                        <controls:Status ViewModel="{x:Bind}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <ProgressRing
                IsActive="True"
                Margin="0 16 0 16"/>
        </StackPanel>
    </ScrollView>
</Page>
