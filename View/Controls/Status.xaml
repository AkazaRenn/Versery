<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="View.Controls.Status"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:View.Controls.StatusComponents"
    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
    BorderThickness="0 0 0 0.5"
    Padding="8 8 8 8"
    ColumnDefinitions="Auto, *"
    ColumnSpacing="8"
    RowDefinitions="Auto, Auto, Auto, Auto"
    RowSpacing="8">

    <Rectangle
        x:Name="AboveLine"
        x:Load="False"
        Grid.Column="0"
        Grid.Row="0"
        Grid.RowSpan="2"
        Width="4"
        Height="28"
        Margin="0 -8 0 0"
        VerticalAlignment="Top"
        Fill="{x:Bind BorderBrush}"/>

    <Rectangle
        x:Name="BelowLine"
        x:Load="False"
        Grid.Column="0"
        Grid.Row="0"
        Grid.RowSpan="6"
        Width="4"
        Margin="0 28 0 -8"
        VerticalAlignment="Stretch"
        Fill="{x:Bind BorderBrush}"/>

    <components:AvatarButton 
        Grid.Column="0"
        Grid.Row="1"
        Margin="0 -8 0 0"
        Height="40"
        Width="40"
        CornerRadius="20"
        ViewModel="{x:Bind ViewModel.AvatarButton, Mode=OneWay}">
    </components:AvatarButton>

    <Grid
        Grid.Column="1"
        Grid.Row="1"
        Margin="0 -8 0 0"
        ColumnDefinitions="*, Auto"
        ColumnSpacing="2">
        <components:PosterInfo
            ViewModel="{x:Bind ViewModel.PosterInfo, Mode=OneWay}"/>
        <TextBlock
            Grid.Column="1"
            Grid.Row="0"
            Text="{x:Bind ViewModel.CreatedAt.ToShortDateString()}"
            HorizontalAlignment="Right"/>
    </Grid>

    <components:Body
        Grid.Column="1"
        Grid.Row="2"
        TextContent="{x:Bind ViewModel.TextContent}"/>

    <components:ReactButtons
        Grid.Column="1"
        Grid.Row="3"
        ViewModel="{x:Bind ViewModel.ReactButtons, Mode=OneWay}">
    </components:ReactButtons>
</Grid>
