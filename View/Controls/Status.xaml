<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="View.Controls.Status"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:View"
    xmlns:richtextrenderer="using:View.Controls.RichTextRenderer"
    xmlns:fluenticons="using:FluentIcons.WinUI"
    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
    BorderThickness="0 0 0 0.5"
    Padding="8 8 8 8"
    ColumnDefinitions="40, *"
    ColumnSpacing="8"
    RowDefinitions="Auto, 40, 8, Auto, Auto"
    Loaded="Grid_Loaded"
    Unloaded="Grid_Unloaded">

    <Rectangle
        x:Name="AboveLine"
        x:Load="{x:Bind LoadAboveLine}"
        Grid.Column="0"
        Grid.Row="0"
        Grid.RowSpan="2"
        Width="{x:Bind LineWidth}"
        Height="{x:Bind AboveLineHeight}"
        Margin="{x:Bind AboveLineMargin}"
        VerticalAlignment="Top"
        Fill="{x:Bind BorderBrush}"/>

    <Rectangle
        x:Name="BelowLine"
        x:Load="{x:Bind LoadBelowLine}"
        Grid.Column="0"
        Grid.Row="1"
        Grid.RowSpan="{x:Bind BelowLineRowSpan}"
        Width="{x:Bind LineWidth}"
        Margin="{x:Bind BelowLineMargin}"
        VerticalAlignment="Stretch"
        Fill="{x:Bind BorderBrush}"/>

    <Grid
        Grid.Column="0"
        Grid.Row="1"
        VerticalAlignment="Top"
        HorizontalAlignment="Left"
        Height="{x:Bind AvatarButtonSize}"
        Width="{x:Bind AvatarButtonSize}"
        CornerRadius="{x:Bind AvatarButtonCornerRadius}">
        <Image>
            <Image.Source>
                <BitmapImage
                    x:Name="PosterAvatarBitmapImage"
                    UriSource="{x:Bind ViewModel.Content.Poster.Avatar, Mode=OneWay}"/>
            </Image.Source>
        </Image>
        <Button
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            BorderThickness="0"
            Padding="0"/>
    </Grid>

    <Border
        x:Name="RebloggerAvatarBorder"
        x:Load="{x:Bind local:Converters.IsNotNull(ViewModel.Reblogger.Id)}"
        Grid.Column="0"
        Grid.Row="1"
        VerticalAlignment="Bottom"
        HorizontalAlignment="Right"
        IsHitTestVisible="False"
        Height="{x:Bind RebloggerAvatarSize}"
        Width="{x:Bind RebloggerAvatarSize}"
        CornerRadius="{x:Bind RebloggerAvatarCornerRadius}">
        <Image>
            <Image.Source>
                <BitmapImage
                    x:Name="RebloggerAvatarBitmapImage"
                    UriSource="{x:Bind ViewModel.Reblogger.Avatar, Mode=OneWay}"/>
            </Image.Source>
        </Image>
    </Border>

    <Grid
        Grid.Column="1"
        Grid.Row="1"
        ColumnDefinitions="*, Auto"
        ColumnSpacing="2">
        <StackPanel
            Grid.Column="0"
            Grid.Row="0"
            Orientation="Vertical">
            <RichTextBlock
                x:Name="DisplayNameTextBlock"
                FontWeight="SemiBold"
                FontSize="16"
                TextTrimming="CharacterEllipsis"
                IsTextSelectionEnabled="False"
                richtextrenderer:Html.ViewModel="{x:Bind ViewModel.Content.Poster.DisplayName}"/>
            <TextBlock
                FontSize="{x:Bind PosterIdFontSize}"
                Foreground="{ThemeResource TextFillColorSecondary}"
                TextTrimming="CharacterEllipsis"
                IsTextSelectionEnabled="False"
                Text="{x:Bind ViewModel.Content.Poster.AccountName}"/>
        </StackPanel>
        <TextBlock
            Grid.Column="1"
            Grid.Row="0"
            Text="{x:Bind ViewModel.Content.CreatedAt.ToShortDateString()}"
            HorizontalAlignment="Right"/>
    </Grid>

    <StackPanel
        Grid.Column="1"
        Grid.Row="3"
        Spacing="{x:Bind RowDefinitions[2].Height.Value}">
        <RichTextBlock
            TextWrapping="WrapWholeWords"
            IsTextSelectionEnabled="False"
            richtextrenderer:Html.ViewModel="{x:Bind ViewModel.Content.PostBody}">
        </RichTextBlock>

        <Grid
            x:Name="MediaAttachments"
            x:Load="{x:Bind LoadMediaAttachments}"
            ColumnDefinitions="1*, 1*"
            ColumnSpacing="2"
            RowDefinitions="1*, 1*"
            RowSpacing="2">
            <Image
                Grid.Column="0"
                Grid.ColumnSpan="{x:Bind MediaAttachment0ColumnSpan}"
                Grid.Row="0"
                Grid.RowSpan="{x:Bind MediaAttachment0RowSpan}">
                <Image.Source>
                    <BitmapImage UriSource="{x:Bind MediaAttachment0Source}"/>
                </Image.Source>
            </Image>
            <Image
                x:Name="MediaAttachment1"
                x:Load="{x:Bind local:Converters.IsNotNull(MediaAttachment1Source)}"
                Grid.Column="1"
                Grid.Row="0"
                Grid.RowSpan="{x:Bind MediaAttachment1RowSpan}">
                <Image.Source>
                    <BitmapImage UriSource="{x:Bind MediaAttachment1Source}"/>
                </Image.Source>
            </Image>
            <Image
                x:Name="MediaAttachment2"
                x:Load="{x:Bind local:Converters.IsNotNull(MediaAttachment2Source)}"
                Grid.Column="0"
                Grid.Row="{x:Bind MediaAttachment2Row}">
                <Image.Source>
                    <BitmapImage UriSource="{x:Bind MediaAttachment2Source}"/>
                </Image.Source>
            </Image>
            <Image
                x:Name="MediaAttachment3"
                x:Load="{x:Bind local:Converters.IsNotNull(MediaAttachment3Source)}"
                Grid.Column="1"
                Grid.Row="1">
                <Image.Source>
                    <BitmapImage UriSource="{x:Bind MediaAttachment3Source}"/>
                </Image.Source>
            </Image>
        </Grid>

        <Grid 
            x:Name="ReactButtons"
            x:Load="{x:Bind LoadReactButtons}"
            ColumnDefinitions="Auto, *, Auto, *, Auto, *, Auto, *, Auto">
            <Button
                Grid.Column="0"
                Background="{x:Bind ReactButtonBackground}"
                BorderBrush="{x:Bind ReactButtonBorderBrush}"
                BorderThickness="{x:Bind ReactButtonBorderThickness}"
                Padding="{x:Bind ReactButtonPadding}">
                <fluenticons:FluentIcon
                    Icon="{x:Bind GetReplyIcon(ViewModel.Content.HasReplies)}"
                    FontSize="{x:Bind ReactButtonFontSize}"/>
            </Button>
            <Button
                Grid.Column="2"
                Background="{x:Bind ReactButtonBackground}"
                BorderBrush="{x:Bind ReactButtonBorderBrush}"
                BorderThickness="{x:Bind ReactButtonBorderThickness}"
                Padding="{x:Bind ReactButtonPadding}">
                <fluenticons:FluentIcon
                    Icon="{x:Bind GetReblogIcon(ViewModel.Content.CanBeReblogged)}"
                    FontSize="{x:Bind ReactButtonFontSize}"/>
            </Button>
            <Button
                Grid.Column="4"
                Background="{x:Bind ReactButtonBackground}"
                BorderBrush="{x:Bind ReactButtonBorderBrush}"
                BorderThickness="{x:Bind ReactButtonBorderThickness}"
                Padding="{x:Bind ReactButtonPadding}">
                <fluenticons:FluentIcon
                    Icon="Star"
                    IconVariant="{x:Bind GetFavouriteIconVariant(ViewModel.Content.IsFavourited)}"
                    FontSize="{x:Bind ReactButtonFontSize}"/>
            </Button>
            <Button
                Grid.Column="6"
                Background="{x:Bind ReactButtonBackground}"
                BorderBrush="{x:Bind ReactButtonBorderBrush}"
                BorderThickness="{x:Bind ReactButtonBorderThickness}"
                Padding="{x:Bind ReactButtonPadding}">
                <fluenticons:FluentIcon
                    x:Name="ShareIcon"
                    Icon="Share"
                    FontSize="{x:Bind ReactButtonFontSize}"/>
            </Button>
            <Button
                Grid.Column="8"
                Background="{x:Bind ReactButtonBackground}"
                BorderBrush="{x:Bind ReactButtonBorderBrush}"
                BorderThickness="{x:Bind ReactButtonBorderThickness}"
                Padding="{x:Bind ReactButtonPadding}">
                <fluenticons:FluentIcon
                    Icon="MoreHorizontal"
                    RenderTransformOrigin="0.5, 0.5"
                    FontSize="{x:Bind ReactButtonFontSize}">
                    <fluenticons:FluentIcon.RenderTransform>
                        <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                    </fluenticons:FluentIcon.RenderTransform>
                </fluenticons:FluentIcon>
            </Button>
        </Grid>
    </StackPanel>

    <Button
        x:Uid="Controls_Status_LoadMoreButton"
        x:Name="LoadMoreButton"
        x:Load="{x:Bind ViewModel.FollowedByGap}"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        Grid.Row="4"
        Height="32"
        HorizontalAlignment="Stretch"
        Background="Transparent"
        BorderThickness="{x:Bind LoadMoreButtonBorderThickness}"
        BorderBrush="{x:Bind BorderBrush}"
        CornerRadius="0"
        Margin="{x:Bind LoadMoreButtonMargin}"/>
</Grid>
