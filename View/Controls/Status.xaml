<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="View.Controls.Status"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:View"
    xmlns:richtextrenderer="using:View.Controls.RichTextRenderer"
    xmlns:fluenticons="using:FluentIcons.WinUI"
    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
    BorderThickness="0 0 0 0.5"
    Padding="8 8 8 2"
    ColumnDefinitions="40, *"
    ColumnSpacing="8"
    RowDefinitions="Auto, 40, 8, Auto, Auto"
    Loaded="Grid_Loaded"
    Unloaded="Grid_Unloaded">

    <Rectangle
        x:Name="AboveLine"
        x:Load="False"
        Grid.Column="0"
        Grid.Row="0"
        Grid.RowSpan="2"
        Width="{x:Bind lineWidth}"
        Height="{x:Bind AboveLineHeight}"
        Margin="{x:Bind AboveLineMargin}"
        VerticalAlignment="Top"
        Fill="{x:Bind BorderBrush}"/>

    <Rectangle
        x:Name="BelowLine"
        x:Load="False"
        Grid.Column="0"
        Grid.Row="1"
        Grid.RowSpan="{x:Bind BelowLineRowSpan}"
        Width="{x:Bind lineWidth}"
        Margin="{x:Bind BelowLineMargin}"
        VerticalAlignment="Stretch"
        Fill="{x:Bind BorderBrush}"/>

    <Grid
        Grid.Column="0"
        Grid.Row="1"
        VerticalAlignment="Top"
        HorizontalAlignment="Left"
        Height="{x:Bind AvatarButtonSize}"
        Width="{x:Bind AvatarButtonSize}"
        CornerRadius="{x:Bind AvatarButtonCornerRadius}">
        <Image>
            <Image.Source>
                <BitmapImage 
                    x:Name="PosterAvatarBitmapImage"
                    UriSource="{x:Bind ViewModel.PosterAvatar, Mode=OneWay}"/>
            </Image.Source>
        </Image>
        <Button 
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            BorderThickness="0"
            Padding="0"/>
    </Grid>

    <Border
        x:Name="RebloggerAvatarBorder"
        x:Load="{x:Bind local:Converters.IsNotNull(ViewModel.RebloggerId)}"
        Grid.Column="0"
        Grid.Row="1"
        VerticalAlignment="Bottom"
        HorizontalAlignment="Right"
        IsHitTestVisible="False"
        Height="{x:Bind RebloggerAvatarSize}"
        Width="{x:Bind RebloggerAvatarSize}"
        CornerRadius="{x:Bind RebloggerAvatarCornerRadius}">
        <Image>
            <Image.Source>
                <BitmapImage
                    x:Name="RebloggerAvatarBitmapImage"
                    UriSource="{x:Bind ViewModel.RebloggerAvatar, Mode=OneWay}"/>
            </Image.Source>
        </Image>
    </Border>

    <Grid
        Grid.Column="1"
        Grid.Row="1"
        ColumnDefinitions="*, Auto"
        ColumnSpacing="2">
        <StackPanel
            Grid.Column="0"
            Grid.Row="0"
            Orientation="Vertical">
            <RichTextBlock
                x:Name="DisplayNameTextBlock"
                FontWeight="SemiBold"
                FontSize="16"
                TextTrimming="CharacterEllipsis"
                IsTextSelectionEnabled="False"
                richtextrenderer:Html.ViewModel="{x:Bind ViewModel.PosterDisplayName}"/>
            <TextBlock
                FontSize="{x:Bind PosterIdFontSize}"
                Foreground="{ThemeResource TextFillColorSecondary}"
                TextTrimming="CharacterEllipsis"
                IsTextSelectionEnabled="False"
                Text="{x:Bind ViewModel.PosterAccount}"/>
        </StackPanel>
        <TextBlock
            Grid.Column="1"
            Grid.Row="0"
            Text="{x:Bind ViewModel.CreatedAt.ToShortDateString()}"
            HorizontalAlignment="Right"/>
    </Grid>

    <StackPanel
        Grid.Column="1"
        Grid.Row="3"
        Spacing="{x:Bind RowDefinitions[2].Height.Value}">
        <RichTextBlock
            TextWrapping="WrapWholeWords"
            IsTextSelectionEnabled="False"
            richtextrenderer:Html.ViewModel="{x:Bind ViewModel.Html}">
        </RichTextBlock>

        <Grid ColumnDefinitions="Auto, *, Auto, *, Auto, *, Auto, *, Auto">

            <Button
                Grid.Column="0"
                Background="{x:Bind reactButtonBackground}"
                BorderBrush="{x:Bind reactButtonBorderBrush}"
                BorderThickness="{x:Bind reactButtonBorderThickness}"
                Padding="{x:Bind reactButtonPadding}">
                <fluenticons:FluentIcon
                    Icon="{x:Bind GetReplyIcon(ViewModel.HasReplies)}"
                    FontSize="{x:Bind reactButtonFontSize}"/>
            </Button>
            <Button
                Grid.Column="2"
                Background="{x:Bind reactButtonBackground}"
                BorderBrush="{x:Bind reactButtonBorderBrush}"
                BorderThickness="{x:Bind reactButtonBorderThickness}"
                Padding="{x:Bind reactButtonPadding}">
                <fluenticons:FluentIcon
                    Icon="{x:Bind GetReblogIcon(ViewModel.CanBeReblogged)}"
                    FontSize="{x:Bind reactButtonFontSize}"/>
            </Button>
            <Button
                Grid.Column="4"
                Background="{x:Bind reactButtonBackground}"
                BorderBrush="{x:Bind reactButtonBorderBrush}"
                BorderThickness="{x:Bind reactButtonBorderThickness}"
                Padding="{x:Bind reactButtonPadding}">
                <fluenticons:FluentIcon
                    Icon="Star"
                    IconVariant="{x:Bind GetFavouriteIconVariant(ViewModel.IsFavourited)}"
                    FontSize="{x:Bind reactButtonFontSize}"/>
            </Button>
            <Button
                Grid.Column="6"
                Background="{x:Bind reactButtonBackground}"
                BorderBrush="{x:Bind reactButtonBorderBrush}"
                BorderThickness="{x:Bind reactButtonBorderThickness}"
                Padding="{x:Bind reactButtonPadding}">
                <fluenticons:FluentIcon
                    x:Name="ShareIcon"
                    Icon="Share"
                    FontSize="{x:Bind reactButtonFontSize}"/>
            </Button>
            <Button
                Grid.Column="8"
                Background="{x:Bind reactButtonBackground}"
                BorderBrush="{x:Bind reactButtonBorderBrush}"
                BorderThickness="{x:Bind reactButtonBorderThickness}"
                Padding="{x:Bind reactButtonPadding}">
                <fluenticons:FluentIcon
                    Icon="MoreHorizontal"
                    RenderTransformOrigin="0.5, 0.5"
                    FontSize="{x:Bind reactButtonFontSize}">
                    <fluenticons:FluentIcon.RenderTransform>
                        <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                    </fluenticons:FluentIcon.RenderTransform>
                </fluenticons:FluentIcon>
            </Button>
        </Grid>
    </StackPanel>

    <Button
        x:Name="LoadMoreButton"
        x:Load="{x:Bind ViewModel.FollowedByGap}"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        Grid.Row="4"
        Height="32"
        HorizontalAlignment="Stretch"
        Background="Transparent"
        BorderThickness="{x:Bind LoadMoreButtonBorderThickness}"
        BorderBrush="{x:Bind BorderBrush}"
        CornerRadius="0"
        Margin="{x:Bind LoadMoreButtonMargin}">
        Load More
    </Button>
</Grid>
