<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="View.Controls.Status"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:View"
    xmlns:components="using:View.Controls.StatusComponents"
    xmlns:richtextrenderer="using:View.Controls.RichTextRenderer"
    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
    BorderThickness="0 0 0 0.5"
    Padding="8 8 8 2"
    ColumnDefinitions="40, *"
    ColumnSpacing="8"
    RowDefinitions="40, Auto"
    RowSpacing="8">

    <Rectangle
        x:Name="AboveLine"
        x:Load="False"
        Grid.Column="0"
        Grid.Row="0"
        Grid.RowSpan="2"
        Width="{x:Bind lineWidth}"
        Height="{x:Bind GetAboveLineHeight(Padding, RowDefinitions[0].Height.Value), Mode=OneWay}"
        Margin="{x:Bind GetAboveLineMargin(Padding), Mode=OneWay}"
        VerticalAlignment="Top"
        Fill="{x:Bind BorderBrush}"/>

    <Rectangle
        x:Name="BelowLine"
        x:Load="False"
        Grid.Column="0"
        Grid.Row="0"
        Grid.RowSpan="{x:Bind GetBelowLineRowSpan(RowDefinitions.Count), Mode=OneWay}"
        Width="{x:Bind lineWidth}"
        Margin="{x:Bind GetBelowLineMargin(Padding, RowDefinitions[0].Height.Value), Mode=OneWay}"
        VerticalAlignment="Stretch"
        Fill="{x:Bind BorderBrush}"/>

    <components:AvatarButton
        Grid.Column="0"
        Grid.Row="0"
        VerticalAlignment="Top"
        HorizontalAlignment="Left"
        Height="{x:Bind GetAvatarButtonSize(ViewModel.RebloggerId, ColumnDefinitions[0].Width.Value), Mode=OneWay}"
        Width="{x:Bind GetAvatarButtonSize(ViewModel.RebloggerId, ColumnDefinitions[0].Width.Value), Mode=OneWay}"
        CornerRadius="{x:Bind GetAvatarButtonCornerRadius(ViewModel.RebloggerId, ColumnDefinitions[0].Width.Value), Mode=OneWay}"
        ViewModel="{x:Bind ViewModel.AvatarButton, Mode=OneWay}">
    </components:AvatarButton>

    <Border
        x:Name="RebloggerAvatarBorder"
        x:Load="{x:Bind local:Converters.NullableObjectToBoolReversed(ViewModel.RebloggerId), Mode=OneWay}"
        Grid.Column="0"
        Grid.Row="0"
        VerticalAlignment="Bottom"
        HorizontalAlignment="Right"
        IsHitTestVisible="False"
        Height="{x:Bind GetRebloggerAvatarSize(ViewModel.RebloggerId, ColumnDefinitions[0].Width.Value), Mode=OneWay}"
        Width="{x:Bind GetRebloggerAvatarSize(ViewModel.RebloggerId, ColumnDefinitions[0].Width.Value), Mode=OneWay}"
        CornerRadius="{x:Bind GetRebloggerAvatarCornerRadius(ViewModel.RebloggerId, ColumnDefinitions[0].Width.Value), Mode=OneWay}">
        <Image>
            <Image.Source>
                <BitmapImage UriSource="{x:Bind ViewModel.RebloggerAvatar, Mode=OneWay}"/>
            </Image.Source>
        </Image>
    </Border>

    <Grid
        Grid.Column="1"
        Grid.Row="0"
        ColumnDefinitions="*, Auto"
        ColumnSpacing="2">
        <components:PosterInfo
            Grid.Column="0"
            Grid.Row="0"
            ViewModel="{x:Bind ViewModel.PosterInfo, Mode=OneWay}"/>
        <TextBlock
            Grid.Column="1"
            Grid.Row="0"
            Text="{x:Bind ViewModel.CreatedAt.ToShortDateString()}"
            HorizontalAlignment="Right"/>
    </Grid>

    <StackPanel
        Grid.Column="1"
        Grid.Row="1"
        Spacing="{x:Bind RowSpacing, Mode=OneWay}">
        <RichTextBlock
            TextWrapping="WrapWholeWords"
            IsTextSelectionEnabled="False"
            richtextrenderer:Html.ViewModel="{x:Bind ViewModel.Html, Mode=OneWay}">
        </RichTextBlock>

        <components:ReactButtons
            ViewModel="{x:Bind ViewModel.ReactButtons, Mode=OneWay}">
        </components:ReactButtons>
    </StackPanel>
</Grid>
