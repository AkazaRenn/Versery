<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="View.Controls.Status"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:View"
    xmlns:controls="using:View.Controls"
    xmlns:components="using:View.Controls.Components"
    xmlns:extensions="using:View.Extensions"
    xmlns:fluenticons="using:FluentIcons.WinUI"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{x:Bind GridColumnWidth0}"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="2"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
        <RowDefinition Height="{x:Bind GridRowHeight0}"/>
        <RowDefinition Height="{x:Bind GridRowHeight1}"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Rectangle
        x:Name="AboveLine"
        x:Load="{x:Bind LoadAboveLine}"
        Grid.Column="0"
        Grid.Row="0"
        Width="{x:Bind LineWidth}"
        VerticalAlignment="Top"
        Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>

    <Rectangle
        x:Name="BelowLine"
        x:Load="{x:Bind LoadBelowLine}"
        Grid.Column="0"
        Grid.Row="0"
        Width="{x:Bind LineWidth}"
        VerticalAlignment="Stretch"
        Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>

    <components:ImageButton
        Grid.Column="0"
        Grid.Row="0"
        Grid.RowSpan="2"
        Width="{x:Bind AvatarSize}"
        Height="{x:Bind AvatarSize}"
        CornerRadius="{x:Bind AvatarButtonCornerRadius}">
        <components:ImageButton.ImageSource>
            <BitmapImage
                x:Name="PosterAvatarButtonBitmapImage"
                UriSource="{x:Bind ViewModel.Poster.Avatar, Mode=OneWay}"/>
        </components:ImageButton.ImageSource>
        <components:ImageButton.RenderTransform>
            <ScaleTransform
                x:Name="AvatarScaleTransform"
                CenterX="0"
                CenterY="0"/>
        </components:ImageButton.RenderTransform>
    </components:ImageButton>

    <RichTextBlock
        Grid.Column="2"
        Grid.Row="0"
        FontWeight="SemiBold"
        FontSize="{x:Bind DisplayNameFontSize}"
        VerticalAlignment="Center"
        TextTrimming="CharacterEllipsis"
        TextWrapping="NoWrap"
        IsTextSelectionEnabled="False"
        extensions:RichTextBlock.Html="{x:Bind ViewModel.Poster.DisplayName}"/>

    <TextBlock
        Grid.Column="2"
        Grid.Row="1"
        FontSize="{x:Bind PosterAccountFontSize}"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        VerticalAlignment="Center"
        TextTrimming="CharacterEllipsis"
        TextWrapping="NoWrap"
        IsTextSelectionEnabled="False"
        Text="{x:Bind ViewModel.Poster.AccountName}"/>

    <TextBlock
        Grid.Column="4"
        Grid.Row="0"
        FontSize="{x:Bind PosterAccountFontSize}"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        VerticalAlignment="Center"
        HorizontalAlignment="Right"
        TextWrapping="NoWrap"
        IsTextSelectionEnabled="False"
        Text="{x:Bind controls:Status.GetStatusTimeString(ViewModel.CreatedAt)}"/>

    <StackPanel
        Grid.Column="{x:Bind ContentStackPanelGridColumn}"
        Grid.ColumnSpan="99"
        Grid.Row="3"
        Spacing="8">

        <Grid
            x:Name="SpoilerTextGrid"
            x:Load="{x:Bind local:Converters.IsNotNull(ViewModel.SpoilerText)}"
            ColumnDefinitions="Auto, *, Auto"
            ColumnSpacing="4">
            <RichTextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                TextWrapping="WrapWholeWords"
                IsTextSelectionEnabled="False"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                extensions:RichTextBlock.Html="{x:Bind ViewModel.SpoilerText}"/>
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                FontSize="12"
                Padding="8, 0, 8, 0"
                Style="{StaticResource AccentButtonStyle}"
                Click="ShowSpoilerButton_Click">
                <fluenticons:FluentIcon
                    x:Name="ShowSpoilerButtonIcon"
                    Icon="ChevronDown"
                    SizeChanged="ShowSpoilerButtonIcon_SizeChanged"
                    Scale="{x:Bind controls:Status.GetShowSpoilerButtonIconScale(ViewModel.Collapsed), Mode=OneWay}"
                    ScaleTransition="{x:Bind local:Transitions.Vector3Transition}">
                </fluenticons:FluentIcon>
            </Button>
        </Grid>

        <Grid
            x:Name="PostBodyGrid"
            Loaded="PostBodyGrid_Loaded"
            Height="{x:Bind controls:Status.GetPostBodyGridInitialHeight(ViewModel.Collapsed)}">
            <ctcontrols:OpacityMaskView >
                <ctcontrols:OpacityMaskView.OpacityMask>
                    <Border
                        Background="{x:Bind local:Brushes.CollapsedStatusBrush}">
                        <Rectangle
                            x:Name="PostBodyRichTextBlockOpacityMaskForeground"
                            Fill="{x:Bind local:Brushes.White}"
                            Opacity="1"/>
                    </Border>
                </ctcontrols:OpacityMaskView.OpacityMask>
                <ScrollView
                    VerticalScrollMode="Disabled"
                    HorizontalScrollMode="Disabled">
                    <RichTextBlock
                        x:Name="PostBodyRichTextBlock"
                        TextWrapping="WrapWholeWords"
                        IsTextSelectionEnabled="False"
                        extensions:RichTextBlock.Html="{x:Bind ViewModel.PostBody}"
                        SizeChanged="PostBodyRichTextBlock_SizeChanged"/>
                </ScrollView>
            </ctcontrols:OpacityMaskView>
            <Button
                x:Name="CollapsePostBodyButton"
                x:Load="{x:Bind local:Converters.IsNull(ViewModel.SpoilerText)}"
                x:Uid="Controls_Status_CollapsePostBodyButton"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Height="24"
                FontSize="12"
                Padding="16,0,16,0"
                Visibility="Collapsed"
                Click="CollapsePostBodyButton_Click"/>
        </Grid>

        <controls:Status
            x:Name="QuoteStatus"
            x:Load="{x:Bind LoadQuote}"
            ViewModel="{x:Bind ViewModel.Quote}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="0.5"
            CornerRadius="4"
            Padding="8"/>

        <ctcontrols:ConstrainedBox
            x:Name="ImagesGrid"
            x:Load="{x:Bind LoadImages}"
            AspectRatio="{x:Bind ImagesGridAspectRatio}"
            CornerRadius="4">
            <Grid>
                <ctcontrols:UniformGrid
                    Columns="2"
                    ColumnSpacing="4"
                    Rows="2"
                    RowSpacing="4"
                    Orientation="{x:Bind ImagesGridOrientation}">
                    <components:MediaPreview
                        x:Name="Image0"
                        UriSource="{x:Bind ViewModel.ImagePreviews[0].Uri, Mode=OneWay}"
                        HideImage="{x:Bind ViewModel.ImagePreviewsHidden, Mode=OneWay}"
                        BackgroundBlur="{x:Bind controls:Status.GetMediaPreviewBackgroundBlurHash(ViewModel.ImagePreviews[0])}">
                    </components:MediaPreview>
                    <components:MediaPreview
                        x:Name="Image1"
                        x:Load="{x:Bind LoadImage1}"
                        UriSource="{x:Bind ViewModel.ImagePreviews[1].Uri, Mode=OneWay}"
                        HideImage="{x:Bind ViewModel.ImagePreviewsHidden, Mode=OneWay}"
                        BackgroundBlur="{x:Bind controls:Status.GetMediaPreviewBackgroundBlurHash(ViewModel.ImagePreviews[1])}">
                    </components:MediaPreview>
                    <components:MediaPreview
                        x:Name="Image2"
                        x:Load="{x:Bind LoadImage2}"
                        UriSource="{x:Bind ViewModel.ImagePreviews[2].Uri, Mode=OneWay}"
                        HideImage="{x:Bind ViewModel.ImagePreviewsHidden, Mode=OneWay}"
                        BackgroundBlur="{x:Bind controls:Status.GetMediaPreviewBackgroundBlurHash(ViewModel.ImagePreviews[2])}">
                    </components:MediaPreview>
                    <components:MediaPreview
                        x:Name="Image3"
                        x:Load="{x:Bind LoadImage3}"
                        UriSource="{x:Bind ViewModel.ImagePreviews[3].Uri, Mode=OneWay}"
                        HideImage="{x:Bind ViewModel.ImagePreviewsHidden, Mode=OneWay}"
                        BackgroundBlur="{x:Bind controls:Status.GetMediaPreviewBackgroundBlurHash(ViewModel.ImagePreviews[3])}">
                        <Border
                            x:Name="Image3Overlay"
                            x:Load="{x:Bind LoadImage3Overlay}"
                            Background="{x:Bind local:Brushes.TransparentBlackHalf}">
                                <TextBlock
                                Foreground="White"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                FontSize="32"
                                FontWeight="ExtraBold"
                                Text="{x:Bind Image3OverlayText}">
                            </TextBlock>
                        </Border>
                    </components:MediaPreview>
                </ctcontrols:UniformGrid>
                <Button
                    x:Name="ToggleMediaPreviewsButton"
                    Command="{x:Bind ViewModel.ToggleImagePreviewsHiddenCommand}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Margin="4,4,0,0"
                    Padding="4">
                    <fluenticons:FluentIcon
                        Icon="{x:Bind controls:Status.GetToggleMediaPreviewsButtonIcon(ViewModel.ImagePreviewsHidden), Mode=OneWay}"
                        FontSize="20"/>
                    <Button.Background>
                        <SolidColorBrush Color="{ThemeResource SystemAltHighColor}" Opacity="0.5"/>
                    </Button.Background>
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemAltHighColor}" Opacity="0.45"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemAltHighColor}" Opacity="0.55"/>
                    </Button.Resources>
                </Button>
            </Grid>
        </ctcontrols:ConstrainedBox>

        <Button
            x:Name="CardButton"
            x:Load="{x:Bind local:Converters.IsNotNull(ViewModel.Card)}"
            Height="96"
            HorizontalAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Padding="0">
            <Grid
                ColumnDefinitions="Auto, *"
                CornerRadius="4">
                <Rectangle 
                    x:Name="CardImageRectangle"
                    x:Load="{x:Bind local:Converters.IsNotNull(ViewModel.Card.ImageRemote)}"
                    Width="96">
                    <Rectangle.Fill>
                        <ImageBrush
                            Stretch="UniformToFill"
                            AlignmentX="Center"
                            AlignmentY="Center">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="{x:Bind ViewModel.Card.Image, Mode=OneWay}"/>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Grid
                    Grid.Column="1"
                    MaxHeight="96"
                    VerticalAlignment="Center"
                    RowDefinitions="Auto, *, Auto"
                    Padding="8,4,8,4">
                    <TextBlock
                        Grid.Row="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        TextTrimming="WordEllipsis"
                        TextWrapping="WrapWholeWords"
                        IsTextSelectionEnabled="False"
                        MaxLines="2"
                        Text="{x:Bind ViewModel.Card.Title}"/>
                    <TextBlock
                        Grid.Row="1"
                        Margin="0, 4, 0, 0"
                        FontSize="12"
                        TextTrimming="WordEllipsis"
                        TextWrapping="WrapWholeWords"
                        IsTextSelectionEnabled="False"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.Card.Description}"/>
                    <TextBlock
                        x:Name="CardProviderNameTextBlock"
                        x:Load="{x:Bind local:Converters.StringIsNotNullOrEmpty(ViewModel.Card.ProviderName)}"
                        Grid.Row="2"
                        Margin="0, 4, 0, 0"
                        FontSize="12"
                        TextTrimming="WordEllipsis"
                        TextWrapping="NoWrap"
                        IsTextSelectionEnabled="False"
                        Foreground="{ThemeResource AccentTextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.Card.ProviderName}"/>
                </Grid>
            </Grid>
        </Button>

        <Grid
            x:Name="ReactButtonsGrid"
            x:Load="{x:Bind ReactButtons}"
            ColumnDefinitions="Auto, *, Auto, *, Auto, *, Auto, *, Auto">
            <Button
                Grid.Column="0"
                Style="{StaticResource SubtleButtonStyle}"
                Padding="{x:Bind controls:Status.ReactButtonPadding}">
                <fluenticons:FluentIcon
                    Icon="{x:Bind controls:Status.GetReplyIcon(ViewModel.IsReply)}"
                    FontSize="{x:Bind controls:Status.ReactButtonFontSize}"/>
            </Button>
            <Button
                Grid.Column="2"
                Style="{StaticResource SubtleButtonStyle}"
                Padding="{x:Bind controls:Status.ReactButtonPadding}"
                IsEnabled="{x:Bind ViewModel.CanBeReblogged}">
                <fluenticons:FluentIcon
                    Icon="{x:Bind controls:Status.GetReblogIcon(ViewModel.CanBeReblogged)}"
                    FontSize="{x:Bind controls:Status.ReactButtonFontSize}"/>
            </Button>
            <Button
                Grid.Column="4"
                Style="{StaticResource SubtleButtonStyle}"
                Padding="{x:Bind controls:Status.ReactButtonPadding}">
                <fluenticons:FluentIcon
                    Icon="Star"
                    IconVariant="{x:Bind controls:Status.GetFavouriteIconVariant(ViewModel.IsFavourited)}"
                    FontSize="{x:Bind controls:Status.ReactButtonFontSize}"/>
            </Button>
            <Button
                Grid.Column="6"
                Style="{StaticResource SubtleButtonStyle}"
                Padding="{x:Bind controls:Status.ReactButtonPadding}">
                <fluenticons:FluentIcon
                    x:Name="ShareIcon"
                    Icon="Share"
                    FontSize="{x:Bind controls:Status.ReactButtonFontSize}"/>
            </Button>
            <Button
                Grid.Column="8"
                Style="{StaticResource SubtleButtonStyle}"
                Padding="{x:Bind controls:Status.ReactButtonPadding}">
                <fluenticons:FluentIcon
                    Icon="MoreHorizontal"
                    RenderTransformOrigin="0.5, 0.5"
                    FontSize="{x:Bind controls:Status.ReactButtonFontSize}">
                    <fluenticons:FluentIcon.RenderTransform>
                        <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                    </fluenticons:FluentIcon.RenderTransform>
                </fluenticons:FluentIcon>
            </Button>
        </Grid>
    </StackPanel>
</Grid>
