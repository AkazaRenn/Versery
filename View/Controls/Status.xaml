<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="View.Controls.Status"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utils="using:View.Utilities"
    xmlns:controls="using:View.Controls"
    xmlns:components="using:View.Controls.Components"
    xmlns:extensions="using:View.Extensions"
    xmlns:fluenticons="using:FluentIcons.WinUI"
    xmlns:vmcontrols="using:ViewModel.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    RowDefinitions="Auto, Auto">

    <Grid
        x:Name="PosterInfoGrid"
        Grid.Row="0"
        ColumnDefinitions="Auto, *, Auto"
        RowDefinitions="*, *"
        Margin="0, 0, 0, 8">
        <components:ImageButton
            x:Name="AvatarButton"
            Grid.Column="0"
            Grid.Row="0"
            Grid.RowSpan="99"
            Margin="0, 0, 8, 0">
            <components:ImageButton.ImageSource>
                <BitmapImage
                    x:Name="PosterAvatarButtonBitmapImage"
                    UriSource="{x:Bind ViewModel.Poster.Avatar, Mode=OneWay}"/>
            </components:ImageButton.ImageSource>
            <components:ImageButton.RenderTransform>
                <ScaleTransform
                    x:Name="AvatarScaleTransform"
                    CenterX="0"
                    CenterY="0"/>
            </components:ImageButton.RenderTransform>
        </components:ImageButton>

        <RichTextBlock
            x:Name="DisplayNameRichTextBlock"
            Grid.Column="1"
            Grid.Row="0"
            FontWeight="Bold"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap"
            IsTextSelectionEnabled="False"
            extensions:RichTextBlock.Html="{x:Bind ViewModel.Poster.DisplayName}"/>

        <TextBlock
            x:Name="StatusTimeTextBlock"
            Grid.Column="2"
            Grid.Row="0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Margin="2, 0, 0, 0"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            TextWrapping="NoWrap"
            IsTextSelectionEnabled="False"
            Text="{x:Bind controls:Status.GetStatusTimeString(ViewModel.CreatedAt)}"/>

        <TextBlock
            x:Name="PosterAccountTextBlock"
            Grid.Column="1"
            Grid.Row="1"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap"
            IsTextSelectionEnabled="False"
            Text="{x:Bind ViewModel.Poster.AccountName}"/>
    </Grid>

    <StackPanel
        x:Name="ContentStackPanel"
        Grid.Row="1"
        Spacing="8">
        <Grid
            x:Name="SpoilerTextGrid"
            x:Load="{x:Bind utils:Converters.IsNotNull(ViewModel.SpoilerText)}"
            ColumnDefinitions="*, Auto"
            ColumnSpacing="4">
            <RichTextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                TextWrapping="WrapWholeWords"
                IsTextSelectionEnabled="False"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                extensions:RichTextBlock.Html="{x:Bind ViewModel.SpoilerText}"
                Tapped="ShowSpoilerButton_Click"/>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12"
                Padding="8, 0, 8, 0"
                Style="{StaticResource AccentButtonStyle}"
                Click="ShowSpoilerButton_Click">
                <fluenticons:FluentIcon
                    x:Name="ShowSpoilerButtonIcon"
                    Icon="ChevronDown"
                    SizeChanged="ShowSpoilerButtonIcon_SizeChanged"
                    Scale="{x:Bind controls:Status.GetShowSpoilerButtonIconScale(ViewModel.Collapsed), Mode=OneWay}"
                    ScaleTransition="{x:Bind utils:Transitions.Vector3Transition}"> </fluenticons:FluentIcon>
            </Button>
        </Grid>

        <Grid
            x:Name="PostBodyGrid"
            Opacity="{x:Bind controls:Status.GetPostBodyGridInitialOpacity(ViewModel.Collapsed)}"
            MaxHeight="{x:Bind controls:Status.GetPostBodyGridInitialHeight(ViewModel.Collapsed)}">
            <ctcontrols:OpacityMaskView
                x:Name="PostBodyGridOpacityMaskView"
                OpacityMask="{x:Bind utils:Values.NullUIElement}">
                <StackPanel Orientation="Vertical">
                    <RichTextBlock
                        x:Name="PostBodyRichTextBlock"
                        TextWrapping="WrapWholeWords"
                        IsTextSelectionEnabled="False"
                        extensions:RichTextBlock.Html="{x:Bind ViewModel.PostBody}"
                        SizeChanged="PostBodyRichTextBlock_SizeChanged"/>
                </StackPanel>
            </ctcontrols:OpacityMaskView>
            <Button
                x:Name="CollapsePostBodyButton"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Height="24"
                FontSize="12"
                Padding="16,0,16,0"
                Visibility="Collapsed"
                IsEnabled="{x:Bind utils:Values.True}"
                Click="CollapsePostBodyButton_Click">
                <fluenticons:FluentIcon Icon="ChevronDown"/>
            </Button>
        </Grid>

        <controls:Status
            x:Name="QuoteStatus"
            x:Load="{x:Bind LoadQuote}"
            ViewModel="{x:Bind ViewModel.Quote}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="0.5"
            CornerRadius="4"
            Padding="8"
            AvatarSize="32"
            DisplayNameFontSize="13"
            PosterAccountFontSize="12"
            PostBodyFontSize="13"/>

        <Grid
            x:Name="MediasGrid"
            x:Load="{x:Bind LoadMedias}"
            CornerRadius="{StaticResource ControlCornerRadius}">
            <components:MediaGrid
                ColumnSpacing="2"
                RowSpacing="2"
                ItemsSource="{x:Bind ViewModel.Medias}">
                <components:MediaGrid.ItemTemplate>
                    <DataTemplate x:DataType="vmcontrols:Status_MediaPreview">
                        <components:MediaPreview
                            UriSource="{x:Bind Uri, Mode=OneWay}"
                            Aspect="{x:Bind Aspect}"
                            Description="{x:Bind Description}"
                            Blurhash="{x:Bind Blurhash}"
                            BlurFadeVisibility="False"
                            BlurOpacity="{x:Bind utils:Converters.BoolToDouble(Hidden), Mode=OneWay}"/>
                    </DataTemplate>
                </components:MediaGrid.ItemTemplate>
            </components:MediaGrid>
            <Border
                VerticalAlignment="{x:Bind controls:Status.GetMediaVisibilityButtonVerticalAlignment(ViewModel.MediaPreviewsHidden), Mode=OneWay}"
                HorizontalAlignment="{x:Bind controls:Status.GetMediaVisibilityButtonHorizontalAlignment(ViewModel.MediaPreviewsHidden), Mode=OneWay}"
                Margin="4">
                <Button
                    Command="{x:Bind ViewModel.ToggleImagePreviewsHiddenCommand}"
                    Padding="8"
                    CornerRadius="8"
                    BorderThickness="2"
                    Scale="{x:Bind controls:Status.GetMediaVisibilityButtonScale(ViewModel.MediaPreviewsHidden), Mode=OneWay}"
                    ScaleTransition="{x:Bind utils:Transitions.Vector3Transition}">
                    <Grid>
                        <fluenticons:FluentIcon
                            Icon="EyeOff"
                            FontSize="40"
                            Opacity="{x:Bind utils:Converters.BoolToDouble(ViewModel.MediaPreviewsHidden), Mode=OneWay}"
                            OpacityTransition="{x:Bind utils:Transitions.ScalarTransition}"/>
                        <fluenticons:FluentIcon
                            Icon="Eye"
                            FontSize="40"
                            Opacity="{x:Bind utils:Converters.BoolToDoubleReversed(ViewModel.MediaPreviewsHidden), Mode=OneWay}"
                            OpacityTransition="{x:Bind utils:Transitions.ScalarTransition}"/>
                    </Grid>
                    <Button.Background>
                        <SolidColorBrush Color="{ThemeResource SystemAltHighColor}" Opacity="0.5"/>
                    </Button.Background>
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                            Color="{ThemeResource SystemAltHighColor}" Opacity="0.45"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed"
                            Color="{ThemeResource SystemAltHighColor}" Opacity="0.55"/>
                    </Button.Resources>
                </Button>
                <Border.Transitions>
                    <TransitionCollection>
                        <RepositionThemeTransition IsStaggeringEnabled="False"/>
                    </TransitionCollection>
                </Border.Transitions>
            </Border>
        </Grid>

        <Button
            x:Name="CardButton"
            x:Load="{x:Bind utils:Converters.IsNotNull(ViewModel.Card)}"
            Height="96"
            HorizontalAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Padding="0"
            Command="{x:Bind ViewModel.Card.InvokeCommand}">
            <Grid
                ColumnDefinitions="Auto, *"
                CornerRadius="4">
                <Rectangle
                    x:Name="CardImageRectangle"
                    x:Load="{x:Bind utils:Converters.IsNotNull(ViewModel.Card.ImageRemote)}"
                    Width="96">
                    <Rectangle.Fill>
                        <ImageBrush
                            Stretch="UniformToFill"
                            AlignmentX="Center"
                            AlignmentY="Center">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="{x:Bind ViewModel.Card.Image, Mode=OneWay}"/>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Grid
                    Grid.Column="1"
                    MaxHeight="96"
                    VerticalAlignment="Center"
                    RowDefinitions="Auto, *, Auto"
                    Padding="8,4,8,4">
                    <TextBlock
                        Grid.Row="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        TextTrimming="WordEllipsis"
                        TextWrapping="WrapWholeWords"
                        IsTextSelectionEnabled="False"
                        MaxLines="2"
                        Text="{x:Bind ViewModel.Card.Title}"/>
                    <TextBlock
                        Grid.Row="1"
                        Margin="0, 4, 0, 0"
                        FontSize="12"
                        TextTrimming="WordEllipsis"
                        TextWrapping="WrapWholeWords"
                        IsTextSelectionEnabled="False"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.Card.Description}"/>
                    <TextBlock
                        x:Name="CardProviderNameTextBlock"
                        x:Load="{x:Bind utils:Converters.StringIsNotNullOrEmpty(ViewModel.Card.ProviderName)}"
                        Grid.Row="2"
                        Margin="0, 4, 0, 0"
                        FontSize="12"
                        TextTrimming="WordEllipsis"
                        TextWrapping="NoWrap"
                        IsTextSelectionEnabled="False"
                        Foreground="{ThemeResource AccentTextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.Card.ProviderName}"/>
                </Grid>
            </Grid>
        </Button>

        <Grid
            x:Name="ReactButtonsGrid"
            x:Load="{x:Bind ReactButtons}"
            ColumnDefinitions="Auto, *, Auto, *, Auto, *, Auto, *, Auto">
            <Button
                Grid.Column="0"
                Style="{StaticResource SubtleButtonStyle}"
                Padding="{x:Bind controls:Status.ReactButtonPadding}">
                <fluenticons:FluentIcon
                    Icon="Comment"
                    FontSize="{x:Bind controls:Status.ReactButtonFontSize}"
                    RenderTransformOrigin="0.5, 0.5">
                    <fluenticons:FluentIcon.RenderTransform>
                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                    </fluenticons:FluentIcon.RenderTransform>
                </fluenticons:FluentIcon>
            </Button>
            <Button
                Grid.Column="2"
                Style="{StaticResource SubtleButtonStyle}"
                Padding="{x:Bind controls:Status.ReactButtonPadding}"
                IsEnabled="{x:Bind ViewModel.CanBeReblogged}"
                Command="{x:Bind ViewModel.ToggleRebloggedCommand}">
                <Grid>
                    <fluenticons:FluentIcon
                        Icon="{x:Bind controls:Status.GetReblogIcon(ViewModel.CanBeReblogged)}"
                        FontSize="{x:Bind controls:Status.ReactButtonFontSize}"
                        Opacity="{x:Bind utils:Converters.BoolToDoubleReversed(ViewModel.IsReblogged), Mode=OneWay}"
                        OpacityTransition="{x:Bind utils:Transitions.ScalarTransition}"/>
                    <fluenticons:FluentIcon
                        Icon="ArrowRepeatAll"
                        Foreground="{x:Bind utils:Brushes.LimeGreen}"
                        FontSize="{x:Bind controls:Status.ReactButtonFontSize}"
                        Opacity="{x:Bind utils:Converters.BoolToDouble(ViewModel.IsReblogged), Mode=OneWay}"
                        OpacityTransition="{x:Bind utils:Transitions.ScalarTransition}"/>
                    <Ellipse
                        Height="2"
                        Width="2"
                        Fill="{x:Bind utils:Brushes.LimeGreen}"
                        Opacity="{x:Bind utils:Converters.BoolToDouble(ViewModel.IsReblogged), Mode=OneWay}"
                        OpacityTransition="{x:Bind utils:Transitions.ScalarTransition}"/>
                </Grid>
            </Button>
            <Button
                Grid.Column="4"
                Style="{StaticResource SubtleButtonStyle}"
                Padding="{x:Bind controls:Status.ReactButtonPadding}"
                Command="{x:Bind ViewModel.ToggleFavouritedCommand}">
                <Grid>
                    <fluenticons:FluentIcon
                        Icon="Star"
                        FontSize="{x:Bind controls:Status.ReactButtonFontSize}"
                        Opacity="{x:Bind utils:Converters.BoolToDoubleReversed(ViewModel.IsFavourited), Mode=OneWay}"
                        OpacityTransition="{x:Bind utils:Transitions.ScalarTransition}"/>
                    <fluenticons:FluentIcon
                        Icon="Star"
                        IconVariant="Filled"
                        Foreground="{x:Bind utils:Brushes.Orange}"
                        FontSize="{x:Bind controls:Status.ReactButtonFontSize}"
                        Opacity="{x:Bind utils:Converters.BoolToDouble(ViewModel.IsFavourited), Mode=OneWay}"
                        OpacityTransition="{x:Bind utils:Transitions.ScalarTransition}"/>
                </Grid>
            </Button>
            <Button
                Grid.Column="6"
                Style="{StaticResource SubtleButtonStyle}"
                Padding="{x:Bind controls:Status.ReactButtonPadding}">
                <fluenticons:FluentIcon
                    x:Name="ShareIcon"
                    Icon="Share"
                    FontSize="{x:Bind controls:Status.ReactButtonFontSize}"/>
            </Button>
            <Button
                Grid.Column="8"
                Style="{StaticResource SubtleButtonStyle}"
                Padding="{x:Bind controls:Status.ReactButtonPadding}">
                <fluenticons:FluentIcon
                    Icon="MoreHorizontal"
                    FontSize="{x:Bind controls:Status.ReactButtonFontSize}"
                    RenderTransformOrigin="0.5, 0.5">
                    <fluenticons:FluentIcon.RenderTransform>
                        <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                    </fluenticons:FluentIcon.RenderTransform>
                </fluenticons:FluentIcon>
            </Button>
        </Grid>
    </StackPanel>
</Grid>