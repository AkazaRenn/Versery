<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="View.Controls.Status"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:View"
    xmlns:controls="using:View.Controls"
    xmlns:extensions="using:View.Extensions"
    xmlns:fluenticons="using:FluentIcons.WinUI"
    xmlns:communitytoolkit="using:CommunityToolkit.WinUI.Controls">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{x:Bind GridColumnWidth0}"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="2"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
        <RowDefinition Height="{x:Bind GridRowHeight0}"/>
        <RowDefinition Height="{x:Bind GridRowHeight1}"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Rectangle
        x:Name="AboveLine"
        x:Load="{x:Bind LoadAboveLine}"
        Grid.Column="0"
        Grid.Row="0"
        Width="{x:Bind LineWidth}"
        VerticalAlignment="Top"
        Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>

    <Rectangle
        x:Name="BelowLine"
        x:Load="{x:Bind LoadBelowLine}"
        Grid.Column="0"
        Grid.Row="0"
        Width="{x:Bind LineWidth}"
        VerticalAlignment="Stretch"
        Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>

    <Grid
        Grid.Column="0"
        Grid.Row="0"
        Grid.RowSpan="2"
        Width="{x:Bind AvatarSize}"
        Height="{x:Bind AvatarSize}"
        CornerRadius="{x:Bind AvatarButtonCornerRadius}">
        <Border
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch">
            <Image extensions:Image.AutoPause="True">
                <Image.Source>
                    <BitmapImage
                        x:Name="PosterAvatarBitmapImage"
                        UriSource="{x:Bind ViewModel.Poster.Avatar, Mode=OneWay}"/>
                </Image.Source>
            </Image>
        </Border>
        <Button
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            BorderThickness="0"
            Padding="0">
        </Button>
        <Grid.RenderTransform>
            <ScaleTransform
                x:Name="AvatarScaleTransform"
                CenterX="0"
                CenterY="0"/>
        </Grid.RenderTransform>
    </Grid>

    <RichTextBlock
        Grid.Column="2"
        Grid.Row="0"
        FontWeight="SemiBold"
        FontSize="{x:Bind DisplayNameFontSize}"
        VerticalAlignment="Center"
        TextTrimming="CharacterEllipsis"
        TextWrapping="NoWrap"
        IsTextSelectionEnabled="False"
        extensions:RichTextBlock.Html="{x:Bind ViewModel.Poster.DisplayName}"/>

    <TextBlock
        Grid.Column="2"
        Grid.Row="1"
        FontSize="{x:Bind PosterAccountFontSize}"
        Foreground="{ThemeResource TextFillColorSecondary}"
        VerticalAlignment="Center"
        TextTrimming="CharacterEllipsis"
        TextWrapping="NoWrap"
        IsTextSelectionEnabled="False"
        Text="{x:Bind ViewModel.Poster.AccountName}"/>

    <TextBlock
        Grid.Column="4"
        Grid.Row="0"
        VerticalAlignment="Center"
        HorizontalAlignment="Right"
        Text="{x:Bind ViewModel.CreatedAt.ToShortDateString()}"/>

    <StackPanel
        Grid.Column="{x:Bind ContentStackPanelGridColumn}"
        Grid.ColumnSpan="99"
        Grid.Row="3"
        Spacing="8">

        <RichTextBlock
            x:Name="SpoilerTextRichTextBlock"
            x:Load="{x:Bind LoadSpoilerTextRichTextBlock}"
            TextWrapping="WrapWholeWords"
            IsTextSelectionEnabled="False"
            extensions:RichTextBlock.Html="{x:Bind ViewModel.SpoilerText}"/>

        <Button
            x:Name="ShowSpoilerButton"
            x:Load="{x:Bind LoadSpoilerTextRichTextBlock}"
            Height="24"
            FontSize="12"
            Padding="16,0,16,0"
            Content="{x:Bind GetShowSpointerButtonContent(ViewModel.Collapsed), Mode=OneWay}"
            Command="{x:Bind ViewModel.ToggleCollapsedCommand}"/>

        <communitytoolkit:OpacityMaskView
            x:Name="OpacityMaskView">
            <communitytoolkit:OpacityMaskView.OpacityMask>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.8" EndPoint="0,1">
                            <GradientStop Offset="0" Color="White"/>
                            <GradientStop Offset="1" Color="Transparent"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </communitytoolkit:OpacityMaskView.OpacityMask>
            <RichTextBlock
                x:Name="PostBodyRichTextBlock"
                Visibility="{x:Bind local:Converters.BoolToVisibilityReversed(ViewModel.Collapsed), Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                IsTextSelectionEnabled="False"
                extensions:RichTextBlock.Html="{x:Bind ViewModel.PostBody}"
                SizeChanged="PostBodyRichTextBlock_SizeChanged"/>
        </communitytoolkit:OpacityMaskView>

        <Button
            x:Name="CollapsePostBodyButton"
            x:Uid="Controls_Status_CollapsePostBodyButton"
            HorizontalAlignment="Center"
            Height="24"
            FontSize="12"
            Padding="16,0,16,0"
            Visibility="Collapsed"
            Click="CollapsePostBodyButton_Click"/>

        <controls:Status
            x:Name="QuoteStatus"
            x:Load="{x:Bind LoadQuote}"
            ViewModel="{x:Bind ViewModel.Quote}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="0.5"
            CornerRadius="4"
            Padding="8"/>

        <communitytoolkit:ConstrainedBox
            x:Name="ImagesGrid"
            x:Load="{x:Bind LoadImages}"
            AspectRatio="{x:Bind ImagesGridAspectRatio}"
            CornerRadius="4">
            <communitytoolkit:UniformGrid
                Columns="2"
                ColumnSpacing="4"
                Rows="2"
                RowSpacing="4"
                Orientation="{x:Bind ImagesGridOrientation}">
                <Rectangle
                    x:Name="Image0">
                    <Rectangle.Fill>
                        <ImageBrush
                            Stretch="UniformToFill"
                            AlignmentX="Center"
                            AlignmentY="Center">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="{x:Bind ViewModel.Image0, Mode=OneWay}"/>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle
                    x:Name="Image1"
                    x:Load="{x:Bind LoadImage1}">
                    <Rectangle.Fill>
                        <ImageBrush
                            Stretch="UniformToFill"
                            AlignmentX="Center"
                            AlignmentY="Center">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="{x:Bind ViewModel.Image1, Mode=OneWay}"/>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle
                    x:Name="Image2"
                    x:Load="{x:Bind LoadImage2}">
                    <Rectangle.Fill>
                        <ImageBrush
                            Stretch="UniformToFill"
                            AlignmentX="Center"
                            AlignmentY="Center">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="{x:Bind ViewModel.Image2, Mode=OneWay}"/>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Border
                    x:Name="Image3"
                    x:Load="{x:Bind LoadImage3}">
                    <Border.Background>
                        <ImageBrush
                            Stretch="UniformToFill"
                            AlignmentX="Center"
                            AlignmentY="Center">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="{x:Bind ViewModel.Image3, Mode=OneWay}"/>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Border.Background>
                    <Border
                        x:Name="Image3Overlay"
                        x:Load="{x:Bind LoadImage3Overlay}"
                        Background="#80000000">
                        <TextBlock
                            Foreground="White"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            FontSize="32"
                            FontWeight="ExtraBold"
                            Text="{x:Bind Image3OverlayText}">
                        </TextBlock>
                    </Border>
                </Border>
            </communitytoolkit:UniformGrid>
        </communitytoolkit:ConstrainedBox>

        <Grid
            x:Name="ReactButtonsGrid"
            x:Load="{x:Bind ReactButtons}"
            ColumnDefinitions="Auto, *, Auto, *, Auto, *, Auto, *, Auto">
            <Button
                Grid.Column="0"
                Background="{x:Bind ReactButtonBackground}"
                BorderBrush="{x:Bind ReactButtonBorderBrush}"
                BorderThickness="{x:Bind ReactButtonBorderThickness}"
                Padding="{x:Bind ReactButtonPadding}">
                <fluenticons:FluentIcon
                    Icon="{x:Bind GetReplyIcon(ViewModel.HasReplies)}"
                    FontSize="{x:Bind ReactButtonFontSize}"/>
            </Button>
            <Button
                Grid.Column="2"
                Background="{x:Bind ReactButtonBackground}"
                BorderBrush="{x:Bind ReactButtonBorderBrush}"
                BorderThickness="{x:Bind ReactButtonBorderThickness}"
                Padding="{x:Bind ReactButtonPadding}"
                IsEnabled="{x:Bind ViewModel.CanBeReblogged}">
                <fluenticons:FluentIcon
                    Icon="{x:Bind GetReblogIcon(ViewModel.CanBeReblogged)}"
                    FontSize="{x:Bind ReactButtonFontSize}"/>
            </Button>
            <Button
                Grid.Column="4"
                Background="{x:Bind ReactButtonBackground}"
                BorderBrush="{x:Bind ReactButtonBorderBrush}"
                BorderThickness="{x:Bind ReactButtonBorderThickness}"
                Padding="{x:Bind ReactButtonPadding}">
                <fluenticons:FluentIcon
                    Icon="Star"
                    IconVariant="{x:Bind GetFavouriteIconVariant(ViewModel.IsFavourited)}"
                    FontSize="{x:Bind ReactButtonFontSize}"/>
            </Button>
            <Button
                Grid.Column="6"
                Background="{x:Bind ReactButtonBackground}"
                BorderBrush="{x:Bind ReactButtonBorderBrush}"
                BorderThickness="{x:Bind ReactButtonBorderThickness}"
                Padding="{x:Bind ReactButtonPadding}">
                <fluenticons:FluentIcon
                    x:Name="ShareIcon"
                    Icon="Share"
                    FontSize="{x:Bind ReactButtonFontSize}"/>
            </Button>
            <Button
                Grid.Column="8"
                Background="{x:Bind ReactButtonBackground}"
                BorderBrush="{x:Bind ReactButtonBorderBrush}"
                BorderThickness="{x:Bind ReactButtonBorderThickness}"
                Padding="{x:Bind ReactButtonPadding}">
                <fluenticons:FluentIcon
                    Icon="MoreHorizontal"
                    RenderTransformOrigin="0.5, 0.5"
                    FontSize="{x:Bind ReactButtonFontSize}">
                    <fluenticons:FluentIcon.RenderTransform>
                        <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                    </fluenticons:FluentIcon.RenderTransform>
                </fluenticons:FluentIcon>
            </Button>
        </Grid>
    </StackPanel>
</Grid>
