<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="View.Controls.Status"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:controls="using:View.Controls"
    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
    BorderThickness="0 0 0 0.5"
    Padding="8 8 8 8"
    ColumnDefinitions="Auto, *"
    ColumnSpacing="8"
    RowDefinitions="Auto, Auto, *, Auto"
    RowSpacing="4">

    <Rectangle
        Grid.Column="0"
        Grid.Row="0"
        Grid.RowSpan="2"
        Width="4"
        Height="28"
        Margin="0 -8 0 0"
        VerticalAlignment="Top"
        Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        Visibility="Collapsed"/>

    <Rectangle
        Grid.Column="0"
        Grid.Row="0"
        Grid.RowSpan="6"
        Width="4"
        Margin="0 28 0 -8"
        VerticalAlignment="Stretch"
        Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        Visibility="Collapsed"/>

    <Button 
        Grid.Column="0"
        Grid.Row="1"
        Height="40"
        Width="40"
        CornerRadius="20"
        BorderThickness="0"
        Padding="0"
        Background="Transparent">
        <Image>
            <Image.Source>
                <BitmapImage UriSource="{x:Bind ViewModel.PosterAvatar, Mode=OneWay}"/>
            </Image.Source>
        </Image>
    </Button>

    <Grid
        Grid.Column="1"
        Grid.Row="1"
        ColumnDefinitions="*, Auto"
        RowDefinitions="Auto, *, Auto">
        <TextBlock
            Grid.Column="0"
            Grid.Row="0"
            FontWeight="SemiBold"
            TextTrimming="CharacterEllipsis"
            Text="{x:Bind ViewModel.PosterDisplayName, Mode=OneWay}"/>
        <TextBlock
            Grid.Column="1"
            Grid.Row="0"
            Text="{x:Bind ViewModel.CreatedAt.ToShortDateString()}"
            HorizontalAlignment="Right"/>
        <TextBlock
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Grid.Row="2"
            TextTrimming="CharacterEllipsis"
            Text="{x:Bind ViewModel.PosterId}"/>
    </Grid>

    <StackPanel
        Grid.Column="1"
        Grid.Row="2">
        <controls:HtmlTextBlock
            TextWrapping="WrapWholeWords"
            IsTextSelectionEnabled="False"
            Html="{x:Bind ViewModel.TextContent}">
        </controls:HtmlTextBlock>
        <ContentPresenter Content="{x:Bind additionalElement, Mode=OneWay}"/>
    </StackPanel>

    <Grid
        Grid.Column="1"
        Grid.Row="3"
        ColumnDefinitions="Auto, *, Auto, *, Auto, *, Auto, *, Auto">
        <Button Grid.Column="0">
            ABC
        </Button>
        <Button Grid.Column="2">
            ABC
        </Button>
        <Button Grid.Column="4">
            ABC
        </Button>
        <Button Grid.Column="6">
            ABC
        </Button>
        <Button Grid.Column="8">
            ABC
        </Button>
    </Grid>
</Grid>
