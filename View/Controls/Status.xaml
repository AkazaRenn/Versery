<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="View.Controls.Status"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utils="using:View.Utilities"
    xmlns:controls="using:View.Controls"
    xmlns:components="using:View.Controls.Components"
    xmlns:extensions="using:View.Extensions"
    xmlns:fluenticons="using:FluentIcons.WinUI"
    xmlns:vmcontrols="using:ViewModel.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{x:Bind GridColumnWidth0}"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="2"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
        <RowDefinition Height="{x:Bind GridRowHeight0}"/>
        <RowDefinition Height="{x:Bind GridRowHeight1}"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Rectangle
        x:Name="AboveLine"
        x:Load="{x:Bind LoadAboveLine}"
        Grid.Column="0"
        Grid.Row="0"
        Width="{x:Bind LineWidth}"
        VerticalAlignment="Top"
        Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>

    <Rectangle
        x:Name="BelowLine"
        x:Load="{x:Bind LoadBelowLine}"
        Grid.Column="0"
        Grid.Row="0"
        Width="{x:Bind LineWidth}"
        VerticalAlignment="Stretch"
        Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>

    <components:ImageButton
        Grid.Column="0"
        Grid.Row="0"
        Grid.RowSpan="2"
        Width="{x:Bind AvatarSize}"
        Height="{x:Bind AvatarSize}"
        CornerRadius="{x:Bind AvatarButtonCornerRadius}">
        <components:ImageButton.ImageSource>
            <BitmapImage
                x:Name="PosterAvatarButtonBitmapImage"
                UriSource="{x:Bind ViewModel.Poster.Avatar, Mode=OneWay}"/>
        </components:ImageButton.ImageSource>
        <components:ImageButton.RenderTransform>
            <ScaleTransform
                x:Name="AvatarScaleTransform"
                CenterX="0"
                CenterY="0"/>
        </components:ImageButton.RenderTransform>
    </components:ImageButton>

    <RichTextBlock
        Grid.Column="2"
        Grid.Row="0"
        FontWeight="SemiBold"
        FontSize="{x:Bind DisplayNameFontSize}"
        VerticalAlignment="Center"
        TextTrimming="CharacterEllipsis"
        TextWrapping="NoWrap"
        IsTextSelectionEnabled="False"
        extensions:RichTextBlock.Html="{x:Bind ViewModel.Poster.DisplayName}"/>

    <TextBlock
        Grid.Column="4"
        Grid.Row="0"
        FontSize="{x:Bind PosterAccountFontSize}"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        VerticalAlignment="Center"
        HorizontalAlignment="Right"
        TextWrapping="NoWrap"
        IsTextSelectionEnabled="False"
        Text="{x:Bind controls:Status.GetStatusTimeString(ViewModel.CreatedAt)}"/>

    <TextBlock
        Grid.Column="2"
        Grid.Row="1"
        FontSize="{x:Bind PosterAccountFontSize}"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        VerticalAlignment="Center"
        TextTrimming="CharacterEllipsis"
        TextWrapping="NoWrap"
        IsTextSelectionEnabled="False"
        Text="{x:Bind ViewModel.Poster.AccountName}"/>

    <StackPanel
        Grid.Column="{x:Bind ContentStackPanelGridColumn}"
        Grid.ColumnSpan="99"
        Grid.Row="3"
        Spacing="8">
        <Grid
            x:Name="SpoilerTextGrid"
            x:Load="{x:Bind utils:Converters.IsNotNull(ViewModel.SpoilerText)}"
            ColumnDefinitions="*, Auto"
            ColumnSpacing="4">
            <RichTextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                TextWrapping="WrapWholeWords"
                IsTextSelectionEnabled="False"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                extensions:RichTextBlock.Html="{x:Bind ViewModel.SpoilerText}"
                Tapped="ShowSpoilerButton_Click"/>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12"
                Padding="8, 0, 8, 0"
                Style="{StaticResource AccentButtonStyle}"
                Click="ShowSpoilerButton_Click">
                <fluenticons:FluentIcon
                    x:Name="ShowSpoilerButtonIcon"
                    Icon="ChevronDown"
                    SizeChanged="ShowSpoilerButtonIcon_SizeChanged"
                    Scale="{x:Bind controls:Status.GetShowSpoilerButtonIconScale(ViewModel.Collapsed), Mode=OneWay}"
                    ScaleTransition="{x:Bind utils:Transitions.Vector3Transition}">
                </fluenticons:FluentIcon>
            </Button>
        </Grid>

        <Grid
            x:Name="PostBodyGrid"
            Opacity="{x:Bind controls:Status.GetPostBodyGridInitialOpacity(ViewModel.Collapsed)}"
            MaxHeight="{x:Bind controls:Status.GetPostBodyGridInitialHeight(ViewModel.Collapsed)}">
            <ctcontrols:OpacityMaskView
                x:Name="PostBodyGridOpacityMaskView"
                OpacityMask="{x:Bind utils:Values.NullUIElement}">
                <StackPanel Orientation="Vertical">
                    <RichTextBlock
                        x:Name="PostBodyRichTextBlock"
                        TextWrapping="WrapWholeWords"
                        IsTextSelectionEnabled="False"
                        extensions:RichTextBlock.Html="{x:Bind ViewModel.PostBody}"
                        SizeChanged="PostBodyRichTextBlock_SizeChanged"/>
                </StackPanel>
            </ctcontrols:OpacityMaskView>
            <Button
                x:Name="CollapsePostBodyButton"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Height="24"
                FontSize="12"
                Padding="16,0,16,0"
                Visibility="Collapsed"
                IsEnabled="{x:Bind utils:Values.True}"
                Click="CollapsePostBodyButton_Click">
                <fluenticons:FluentIcon Icon="ChevronDown"/>
            </Button>
        </Grid>

        <controls:Status
            x:Name="QuoteStatus"
            x:Load="{x:Bind LoadQuote}"
            ViewModel="{x:Bind ViewModel.Quote}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="0.5"
            CornerRadius="4"
            Padding="8"/>

        <components:MediaGrid
            x:Name="MediasGrid"
            x:Load="{x:Bind LoadMedias}"
            ColumnSpacing="4"
            RowSpacing="4"
            ItemsSource="{x:Bind ViewModel.Medias}"
            ToggleMediaPreviewsCommand="{x:Bind ViewModel.ToggleImagePreviewsHiddenCommand}"
            MediaPreviewsHidden="{x:Bind ViewModel.MediaPreviewsHidden, Mode=OneWay}">
            <components:MediaGrid.ItemTemplate>
                <DataTemplate x:DataType="vmcontrols:Status_MediaPreview">
                    <components:MediaPreview
                        UriSource="{x:Bind Uri, Mode=OneWay}"
                        Aspect="{x:Bind Aspect}"
                        Blurhash="{x:Bind Blurhash}"
                        Description="{x:Bind Description}"
                        ImageFadeVisibility="False"
                        ImageOpacity="{x:Bind controls:Status.GetImageOpacity(Hidden), Mode=OneWay}"/>
                </DataTemplate>
            </components:MediaGrid.ItemTemplate>
        </components:MediaGrid>

        <components:PreviewCard
            x:Name="CardButton"
            x:Load="{x:Bind utils:Converters.IsNotNull(ViewModel.Card)}"
            Height="96"
            HorizontalAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Padding="0"
            Command="{x:Bind ViewModel.Card.InvokeCommand}"
            LoadImage="{x:Bind utils:Converters.IsNotNull(ViewModel.Card.ImageRemote)}"
            ImageSource="{x:Bind ViewModel.Card.Image, Mode=OneWay}"
            Title="{x:Bind ViewModel.Card.Title}"
            Description="{x:Bind ViewModel.Card.Description}"
            LoadProviderName="{x:Bind utils:Converters.StringIsNotNullOrEmpty(ViewModel.Card.ProviderName)}"
            ProviderName="{x:Bind ViewModel.Card.ProviderName}"/>

        <components:ReactButtons
            x:Name="ReactButtonsGrid"
            x:Load="{x:Bind ReactButtons}"
            ReblogButtonIsEnabled="{x:Bind ViewModel.CanBeReblogged}"
            ReblogButtonCommand="{x:Bind ViewModel.ToggleRebloggedCommand}"
            IsReblogged="{x:Bind ViewModel.IsReblogged, Mode=OneWay}"
            FavouriteButtonCommand="{x:Bind ViewModel.ToggleFavouritedCommand}"
            IsFavourited="{x:Bind ViewModel.IsFavourited, Mode=OneWay}"/>
    </StackPanel>
</Grid>