<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="View.Controls.Status"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:View.Controls.StatusComponents"
    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
    BorderThickness="0 0 0 0.5"
    Padding="8 8 8 8"
    ColumnDefinitions="Auto, *"
    ColumnSpacing="8"
    RowDefinitions="Auto, Auto, *, Auto"
    RowSpacing="4">

    <Rectangle
        Grid.Column="0"
        Grid.Row="0"
        Grid.RowSpan="2"
        Width="4"
        Height="28"
        Margin="0 -8 0 0"
        VerticalAlignment="Top"
        Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        Visibility="Collapsed"/>

    <Rectangle
        Grid.Column="0"
        Grid.Row="0"
        Grid.RowSpan="6"
        Width="4"
        Margin="0 28 0 -8"
        VerticalAlignment="Stretch"
        Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        Visibility="Collapsed"/>

    <components:AvatarButton 
        Grid.Column="0"
        Grid.Row="1"
        Height="40"
        Width="40"
        CornerRadius="20"
        Avatar="{x:Bind ViewModel.PosterAvatar, Mode=OneWay}">
    </components:AvatarButton>

    <Grid
        Grid.Column="1"
        Grid.Row="1"
        ColumnDefinitions="*, Auto"
        ColumnSpacing="2">
        <components:PosterInfo
            DisplayName="{x:Bind ViewModel.PosterDisplayName, Mode=OneWay}"
            Id="{x:Bind ViewModel.PosterId, Mode=OneWay}"/>
        <TextBlock
            Grid.Column="1"
            Grid.Row="0"
            Text="{x:Bind ViewModel.CreatedAt.ToShortDateString()}"
            HorizontalAlignment="Right"/>
    </Grid>

    <components:Body
        Grid.Column="1"
        Grid.Row="2"
        TextContent="{x:Bind ViewModel.TextContent}"
        AdditionalContent="{x:Bind additionalElement, Mode=OneWay}"/>

    <components:ReactButtons
        Grid.Column="1"
        Grid.Row="3">
    </components:ReactButtons>
</Grid>
