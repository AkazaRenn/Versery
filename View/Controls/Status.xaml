<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="View.Controls.Status"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:controls="using:View.Controls"
    DataContext="{x:Bind ViewModel}"
    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
    <StackPanel
        Orientation="Vertical"
        Margin="8 8 8 0">
        <Grid
            Margin="0 0 0 4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button 
                Grid.Column="0"
                Height="40"
                Width="40"
                CornerRadius="20"
                BorderThickness="0"
                Padding="0"
                Margin="0 0 8 0"
                Background="Transparent">
                <Image>
                    <Image.Source>
                        <BitmapImage UriSource="{x:Bind ViewModel.PosterAvatar, Mode=OneWay}"/>
                    </Image.Source>
                </Image>
            </Button>
            <Grid
                Grid.Column="1"
                VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    FontWeight="SemiBold"
                    VerticalAlignment="Top"
                    Text="{x:Bind ViewModel.PosterDisplayName, Mode=OneWay}"/>
                <TextBlock
                    Grid.Row="2"
                    FontWeight="Light"
                    VerticalAlignment="Bottom"
                    TextTrimming="CharacterEllipsis"
                    Text="{x:Bind ViewModel.PosterId}"/>
            </Grid>
            <TextBlock
                Grid.Column="2"
                Text="{x:Bind ViewModel.CreatedAt.ToShortTimeString()}"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"/>
        </Grid>
        <controls:HtmlTextBlock
            TextWrapping="WrapWholeWords"
            IsTextSelectionEnabled="False"
            Html="{x:Bind ViewModel.TextContent}">
        </controls:HtmlTextBlock>
            <StackPanel
            Orientation="Horizontal">
            <AppBarToggleButton
                Icon="Accept"
                Height="64"
                Width="64"
                CornerRadius="32"/>
            <AppBarToggleButton
                Icon="Accept"
                Height="16"
                Width="16"
                CornerRadius="8"/>
            <AppBarToggleButton
                Icon="Accept"
                Height="16"
                Width="16"
                CornerRadius="8"/>
            <AppBarToggleButton
                Icon="Accept"
                Height="16"
                Width="16"
                CornerRadius="8"/>
        </StackPanel>
    </StackPanel>
</Grid>
