<?xml version="1.0" encoding="utf-8"?>
<StackPanel
    x:Class="View.Controls.StatusComponents.PosterInfo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:richtextrenderer="using:View.Controls.RichTextRenderer">
    <RichTextBlock
        x:Name="DisplayNameTextBlock"
        FontWeight="SemiBold"
        FontSize="16"
        TextTrimming="CharacterEllipsis"
        IsTextSelectionEnabled="False"
        richtextrenderer:TextWithEmoji.ViewModel="{x:Bind ViewModel.DisplayNameInfo, Mode=OneWay}"/>
    <TextBlock
        FontSize="{x:Bind GetIdFontSize(DisplayNameTextBlock.FontSize)}"
        Foreground="{ThemeResource TextFillColorSecondary}"
        TextTrimming="CharacterEllipsis"
        IsTextSelectionEnabled="False"
        Text="{x:Bind ViewModel.AccountName, Mode=OneWay}"/>
</StackPanel>
