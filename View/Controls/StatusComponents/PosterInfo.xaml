<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="View.Controls.StatusComponents.PosterInfo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RowDefinitions="Auto, *, Auto">
    <TextBlock
        x:Name="DisplayNameTextBlock"
        Grid.Row="0"
        FontWeight="SemiBold"
        FontSize="16"
        TextTrimming="CharacterEllipsis"
        Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}"/>
    <TextBlock
        Grid.Row="2"
        FontSize="{x:Bind GetIdFontSize(DisplayNameTextBlock.FontSize)}"
        Opacity="0.75"
        TextTrimming="CharacterEllipsis"
        Text="{x:Bind ViewModel.AccountName, Mode=OneWay}"/>
</Grid>
