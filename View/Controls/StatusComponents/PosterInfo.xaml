<?xml version="1.0" encoding="utf-8"?>
<StackPanel
    x:Class="View.Controls.StatusComponents.PosterInfo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TextBlock
        x:Name="DisplayNameTextBlock"
        FontWeight="SemiBold"
        FontSize="16"
        TextTrimming="CharacterEllipsis"
        Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}"/>
    <TextBlock
        FontSize="{x:Bind GetIdFontSize(DisplayNameTextBlock.FontSize)}"
        Opacity="0.75"
        TextTrimming="CharacterEllipsis"
        Text="{x:Bind ViewModel.AccountName, Mode=OneWay}"/>
</StackPanel>
