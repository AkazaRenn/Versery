<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="View.Controls.StatusComponents.ReactButtons"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluenticons="using:FluentIcons.WinUI"
    ColumnDefinitions="Auto, *, Auto, *, Auto, *, Auto, *, Auto">
    <Button
        Grid.Column="0"
        Background="{x:Bind background}"
        BorderBrush="{x:Bind borderBrush}"
        BorderThickness="{x:Bind borderThickness}"
        Padding="{x:Bind padding}">
        <fluenticons:FluentIcon
            Icon="{x:Bind GetReplyIcon(ViewModel.HasReplies)}"
            FontSize="{x:Bind fontSize}"/>
    </Button>
    <Button
        Grid.Column="2"
        Background="{x:Bind background}"
        BorderBrush="{x:Bind borderBrush}"
        BorderThickness="{x:Bind borderThickness}"
        Padding="{x:Bind padding}">
        <fluenticons:FluentIcon
            Icon="{x:Bind GetReblogIcon(ViewModel.CanBeReblogged)}"
            FontSize="{x:Bind fontSize}"/>
    </Button>
    <Button
        Grid.Column="4"
        Background="{x:Bind background}"
        BorderBrush="{x:Bind borderBrush}"
        BorderThickness="{x:Bind borderThickness}"
        Padding="{x:Bind padding}">
        <fluenticons:FluentIcon
            Icon="Star"
            IconVariant="{x:Bind GetFavouriteIconVariant(ViewModel.IsFavourited)}"
            FontSize="{x:Bind fontSize}"/>
    </Button>
    <Button
        Grid.Column="6"
        Background="{x:Bind background}"
        BorderBrush="{x:Bind borderBrush}"
        BorderThickness="{x:Bind borderThickness}"
        Padding="{x:Bind padding}">
        <fluenticons:FluentIcon
            x:Name="ShareIcon"
            Icon="Share"
            FontSize="{x:Bind fontSize}"/>
    </Button>
    <Button
        Grid.Column="8"
        Background="{x:Bind background}"
        BorderBrush="{x:Bind borderBrush}"
        BorderThickness="{x:Bind borderThickness}"
        Padding="{x:Bind padding}">
        <fluenticons:FluentIcon
            Icon="MoreHorizontal"
            RenderTransformOrigin="0.5, 0.5"
            FontSize="{x:Bind fontSize}">
            <fluenticons:FluentIcon.RenderTransform>
                <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
            </fluenticons:FluentIcon.RenderTransform>
        </fluenticons:FluentIcon>
    </Button>
</Grid>
