<?xml version="1.0" encoding="utf-8"?>
<Button
    x:Class="View.Controls.StatusComponents.AvatarButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    BorderThickness="0"
    Padding="0"
    Background="Transparent">
    <Image>
        <Image.Source>
            <BitmapImage UriSource="{x:Bind ViewModel.ContentPosterAvatar, Mode=OneWay}"/>
        </Image.Source>
    </Image>
</Button>
