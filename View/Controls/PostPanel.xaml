<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="View.Controls.PostPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utils="using:View.Utilities"
    Visibility="Collapsed"
    Opened="ContentDialog_Opened">
    <Popup
        x:Name="Popup"
        IsOpen="False">
        <Grid
            x:Name="SmokeLayer"
            Loaded="SmokeLayer_Loaded"
            Unloaded="SmokeLayer_Unloaded">
            <Rectangle
                x:Name="SmokeLayerBackground"
                Fill="{ThemeResource SmokeFillColorDefaultBrush}"
                Opacity="0"
                OpacityTransition="{x:Bind utils:Transitions.ScalarTransition}"/>
            <Border
                x:Name="Dialog"
                Background="Red"
                Margin="0, 128, 0, 0"
                SizeChanged="Dialog_SizeChanged"
                PointerPressed="Dialog_PointerPressed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DialogTranslateTransform"/>
                </Border.RenderTransform>
            </Border>
        </Grid>
    </Popup>
</ContentDialog>