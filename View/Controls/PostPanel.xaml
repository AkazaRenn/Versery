<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="View.Controls.PostPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utils="using:View.Utilities"
    Visibility="Collapsed"
    Opened="ContentDialog_Opened">
    <Popup
        x:Name="Popup"
        IsOpen="False">
        <Border 
            x:Name="Container"
            Loaded="Container_Loaded">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ContainerTranslateTransform"/>
            </Border.RenderTransform>
            <Border
                x:Name="ContentInternal"
                Background="Red"
                Margin="0, 128, 0, 0"
                Width="400"
                PointerPressed="Content_PointerPressed">
            </Border>
        </Border>
    </Popup>
</ContentDialog>