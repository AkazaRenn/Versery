<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="View.Controls.PostPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:View"
    Visibility="Collapsed"
    Loaded="ContentDialog_Loaded">
    <Popup
        x:Name="Popup"
        IsOpen="False">
        <Grid x:Name="Grid">
            <Rectangle
                x:Name="SmokeLayerBackground"
                Fill="{ThemeResource SmokeFillColorDefaultBrush}"
                Opacity="0"
                OpacityTransition="{x:Bind local:Transitions.ScalarTransition}"/>
            <Border
                x:Name="Dialog"
                Background="Red"
                Margin="0, 128, 0, 0"
                Loaded="Dialog_Loaded"
                SizeChanged="Dialog_SizeChanged"
                PointerPressed="Dialog_PointerPressed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DialogTranslateTransform"/>
                </Border.RenderTransform>
            </Border>
        </Grid>
    </Popup>
</ContentDialog>