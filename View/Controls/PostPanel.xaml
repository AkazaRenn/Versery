<?xml version="1.0" encoding="utf-8"?>
<components:SlideDialog
    x:Class="View.Controls.PostPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:View.Controls.Components"
    xmlns:enumerations="using:ViewModel.Enumerations"
    xmlns:utilities="using:View.Utilities"
    xmlns:vm.controls="using:ViewModel.Controls"
    xmlns:fluenticons="using:FluentIcons.WinUI"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    Loaded="SlideDialog_Loaded">
    <Grid
        x:Name="PanelRoot"
        RowDefinitions="48, Auto, *, 48"
        Margin="0, 128, 0, 0"
        Padding="8, 0, 8, 0"
        CornerRadius="8, 8, 0, 0"
        BorderBrush="{ThemeResource ContentDialogBorderBrush}"
        BorderThickness="{ThemeResource CommandBarOverflowPresenterBorderUpThickness}"
        Background="{ThemeResource ContentDialogBackground}">
        <RelativePanel
            Grid.Row="0"
            Margin="-4, 0, 0, 0">
            <Button
                x:Name="DismissButton"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.AlignVerticalCenterWithPanel="True"
                Height="36"
                Width="40"
                Tapped="DismissButton_Tapped"
                Style="{StaticResource SubtleButtonStyle}"
                IsEnabled="{x:Bind viewModel.IsEnabled, Mode=OneWay}">
                <fluenticons:FluentIcon
                    Icon="Dismiss"
                    FontSize="16" />
            </Button>
            <Button
                x:Name="VisibilityButton"
                RelativePanel.LeftOf="ContentWarningButton"
                RelativePanel.AlignVerticalCenterWithPanel="True"
                Style="{StaticResource SubtleButtonStyle}"
                IsEnabled="{x:Bind viewModel.IsEnabled, Mode=OneWay}">
                <components:SwitchContentPanel CurrentContent="{x:Bind GetVisibilityFluentIcon(viewModel.Visibility), Mode=OneWay}">
                    <components:SwitchContentPanel.DefaultContent>
                        <fluenticons:FluentIcon Icon="Globe" />
                    </components:SwitchContentPanel.DefaultContent>
                </components:SwitchContentPanel>
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem
                            x:Uid="Controls_PostPanel_VisibilityButton_FlyoutItem_Public"
                            Command="{x:Bind viewModel.SetVisibilityCommand}"
                            CommandParameter="{x:Bind enumerations:Visibility.Public}">
                            <MenuFlyoutItem.Icon>
                                <fluenticons:FluentIcon Icon="Globe"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="Controls_PostPanel_VisibilityButton_FlyoutItem_Unlisted"
                            Command="{x:Bind viewModel.SetVisibilityCommand}"
                            CommandParameter="{x:Bind enumerations:Visibility.Unlisted}">
                            <MenuFlyoutItem.Icon>
                                <fluenticons:FluentIcon Icon="LockOpen"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="Controls_PostPanel_VisibilityButton_FlyoutItem_Private"
                            Command="{x:Bind viewModel.SetVisibilityCommand}"
                            CommandParameter="{x:Bind enumerations:Visibility.Private}">
                            <MenuFlyoutItem.Icon>
                                <fluenticons:FluentIcon Icon="LockClosed"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Uid="Controls_PostPanel_VisibilityButton_FlyoutItem_Direct"
                            Command="{x:Bind viewModel.SetVisibilityCommand}"
                            CommandParameter="{x:Bind enumerations:Visibility.Direct}">
                            <MenuFlyoutItem.Icon>
                                <fluenticons:FluentIcon Icon="Mail"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button
                Visibility="Collapsed"
                x:Name="ContentWarningButton"
                RelativePanel.LeftOf="ScheduleButton"
                RelativePanel.AlignVerticalCenterWithPanel="True"
                Margin="4, 0, 0, 0"
                Style="{StaticResource SubtleButtonStyle}"
                IsEnabled="{x:Bind viewModel.IsEnabled, Mode=OneWay}">
                <fluenticons:FluentIcon Icon="Warning" />
            </Button>
            <Button
                Visibility="Collapsed"
                x:Name="ScheduleButton"
                RelativePanel.LeftOf="LanguageButton"
                RelativePanel.AlignVerticalCenterWithPanel="True"
                Margin="4, 0, 0, 0"
                Style="{StaticResource SubtleButtonStyle}"
                IsEnabled="{x:Bind viewModel.IsEnabled, Mode=OneWay}">
                <fluenticons:FluentIcon Icon="Calendar" />
            </Button>
            <Button
                x:Name="LanguageButton"
                RelativePanel.LeftOf="AvatarButton"
                RelativePanel.AlignVerticalCenterWithPanel="True"
                Margin="4, 0, 0, 0"
                Style="{StaticResource SubtleButtonStyle}"
                IsEnabled="{x:Bind viewModel.IsEnabled, Mode=OneWay}">
                <fluenticons:FluentIcon Icon="LocalLanguageGlobe" />
                <Button.Flyout>
                    <MenuFlyout
                        x:Name="LanguageButtonMenuFlyout"
                        Opening="LanguageButtonMenuFlyout_Opening"
                        Opened="LanguageButtonMenuFlyout_Opened">
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <components:ImageButton
                x:Name="AvatarButton"
                RelativePanel.AlignRightWithPanel="True"
                RelativePanel.AlignVerticalCenterWithPanel="True"
                Margin="4, 0, 0, 0"
                Visibility="Collapsed"
                IsEnabled="{x:Bind viewModel.IsEnabled, Mode=OneWay}">
            </components:ImageButton>
        </RelativePanel>
        <TextBox
            x:Name="ContentWarningTextBox"
            x:Uid="Controls_PostPanel_ContentWarningTextBox"
            Grid.Row="1"
            Padding="8"
            Margin="0, 0, 0, 8"
            Text="{x:Bind viewModel.SpoilerText, Mode=TwoWay}"
            IsEnabled="{x:Bind viewModel.IsEnabled, Mode=OneWay}"
            GotFocus="TextBox_GotFocus"/>
        <ctcontrols:RichSuggestBox
            x:Name="ContentBox"
            x:Uid="Controls_PostPanel_ContentBox"
            Grid.Row="2"
            Padding="8"
            VerticalAlignment="Stretch"
            ClipboardCopyFormat="PlainText"
            ClipboardPasteFormat="PlainText"
            DisabledFormattingAccelerators="All"
            IsEnabled="{x:Bind viewModel.IsEnabled, Mode=OneWay}"
            Loaded="ContentBox_Loaded"
            GotFocus="TextBox_GotFocus"/>
        <RelativePanel
            Grid.Row="3">
            <Button
                x:Name="AddMediaButton"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.AlignVerticalCenterWithPanel="True"
                Margin="0, 0, 4, 0"
                Style="{StaticResource SubtleButtonStyle}"
                Visibility="Collapsed"
                IsEnabled="{x:Bind viewModel.IsEnabled, Mode=OneWay}">
                <fluenticons:FluentIcon Icon="Attach" />
            </Button>
            <Button
                x:Name="EmojiButton"
                RelativePanel.RightOf="AddMediaButton"
                RelativePanel.AlignVerticalCenterWithPanel="True"
                Margin="0, 0, 4, 0"
                Tapped="EmojiButton_Tapped"
                Style="{StaticResource SubtleButtonStyle}"
                IsEnabled="{x:Bind viewModel.IsEnabled, Mode=OneWay}">
                <components:SwitchContentPanel IsUsingDefaultContent="{x:Bind utilities:Converters.Reverse(EmojiPicker.IsOpen), Mode=OneWay}">
                    <components:SwitchContentPanel.DefaultContent>
                        <fluenticons:FluentIcon Icon="Emoji" />
                    </components:SwitchContentPanel.DefaultContent>
                    <components:SwitchContentPanel.AlternateContent>
                        <fluenticons:FluentIcon Icon="Emoji" IconVariant="Filled"/>
                    </components:SwitchContentPanel.AlternateContent>
                </components:SwitchContentPanel>
            </Button>
            <Button
                x:Name="PollButton"
                RelativePanel.RightOf="EmojiButton"
                RelativePanel.AlignVerticalCenterWithPanel="True"
                Visibility="Collapsed"
                Style="{StaticResource SubtleButtonStyle}"
                IsEnabled="{x:Bind viewModel.IsEnabled, Mode=OneWay}">
                <fluenticons:FluentIcon Icon="Poll" />
            </Button>
            <Button
                x:Name="PostButton"
                RelativePanel.AlignRightWithPanel="True"
                RelativePanel.AlignVerticalCenterWithPanel="True"
                Style="{StaticResource AccentButtonStyle}"
                IsEnabled="{x:Bind viewModel.IsEnabled, Mode=OneWay}"
                Tapped="PostButton_Tapped">
                <components:SwitchContentPanel IsUsingDefaultContent="{x:Bind viewModel.IsEnabled, Mode=OneWay}">
                    <components:SwitchContentPanel.DefaultContent>
                        <fluenticons:FluentIcon
                            x:Name="PostButtonIcon"
                            Icon="Send" />
                    </components:SwitchContentPanel.DefaultContent>
                    <components:SwitchContentPanel.AlternateContent>
                        <ProgressRing
                            Width="{x:Bind PostButtonIcon.FontSize}"
                            Height="{x:Bind PostButtonIcon.FontSize}"
                            IsActive="True"/>
                    </components:SwitchContentPanel.AlternateContent>
                </components:SwitchContentPanel>
            </Button>
            <TeachingTip
                x:Name="EmojiPicker"
                IsLightDismissEnabled="True"
                Target="{x:Bind EmojiButton}"
                Closed="EmojiPicker_Closed">
                <Grid
                    RowDefinitions="Auto, *"
                    Margin="-12, -12, -12, -12"
                    Width="300">
                    <TextBox
                        x:Name="EmojiSearchTextBox"
                        Grid.Row="0"
                        Margin="-4, 0, -4, 0"
                        Padding="41, 9, 6, 10"
                        HorizontalAlignment="Stretch"
                        Text="{x:Bind viewModel.EmojiFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <FontIcon
                        Grid.Row="0"
                        Margin="12, 12, 0, 0"
                        FontSize="16"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Glyph="&#xE721;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <GridView
                        x:Name="EmojiGridView"
                        Grid.Row="1"
                        Height="244"
                        Margin="0, 0, -4, 0"
                        Padding="0, 4, 0, 0"
                        HorizontalAlignment="Center"
                        ItemsSource="{x:Bind viewModel.EmojisView}"
                        IsItemClickEnabled="True"
                        SelectionMode="None"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        ContainerContentChanging="EmojiGridView_ContainerContentChanging"
                        ItemClick="EmojiGridView_ItemClick">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm.controls:PostPanel_Emoji">
                                <components:Emoji
                                    Height="32"
                                    Width="32"
                                    Shortcode="{x:Bind Shortcode}"
                                    Source="{x:Bind Source, Mode=OneWay}"/>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </TeachingTip>
        </RelativePanel>
    </Grid>
</components:SlideDialog>