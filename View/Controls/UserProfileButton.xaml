<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="View.Controls.UserProfileButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:View.Controls.Components"
    xmlns:fluenticons="using:FluentIcons.WinUI">
    <components:ImageButton x:Name="ImageButton">
        <components:ImageButton.Flyout>
            <MenuFlyout Placement="Bottom">
                <MenuFlyoutItem Text="Settings">
                    <MenuFlyoutItem.Icon>
                        <fluenticons:FluentIcon Icon="Settings"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutSubItem x:Uid="Controls_UserProfileButton_MenuFlyout_ManageAccounts">
                    <MenuFlyoutSubItem.Icon>
                        <fluenticons:FluentIcon Icon="Person"/>
                    </MenuFlyoutSubItem.Icon>
                    <MenuFlyoutItem
                        x:Uid="Controls_UserProfileButton_MenuFlyout_ManageAccounts_AddAccount"
                        Command="{x:Bind viewModel.AddAccountCommand}">
                        <MenuFlyoutItem.Icon>
                            <fluenticons:FluentIcon Icon="Add"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Uid="Controls_UserProfileButton_MenuFlyout_ManageAccounts_SignOut"
                        Command="{x:Bind viewModel.SignOutCommand}">
                        <MenuFlyoutItem.Icon>
                            <fluenticons:FluentIcon Icon="ArrowExit"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyoutSubItem>
            </MenuFlyout>
        </components:ImageButton.Flyout>
        <components:ImageButton.ImageSource>
            <BitmapImage x:Name="BitmapImage"/>
        </components:ImageButton.ImageSource>
    </components:ImageButton>
</UserControl>
