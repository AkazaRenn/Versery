<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="View.Controls.Timeline"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:View"
    xmlns:controls="using:View.Controls"
    xmlns:extensions="using:View.Extensions"
    xmlns:fluenticons="using:FluentIcons.WinUI"
    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
    ColumnDefinitions="48, *"
    ColumnSpacing="8"
    RowDefinitions="Auto, Auto, Auto">

    <RichTextBlock
        x:Name="ReactorDisplayName"
        x:Load="{x:Bind local:Converters.IsNotNull(ViewModel.Reblogger)}"
        Grid.Column="1"
        Grid.Row="0"
        Margin="0,4,0,-4"
        FontSize="12"
        Foreground="{ThemeResource TextFillColorTertiary}"
        IsTextSelectionEnabled="False">
        <Paragraph>
            <Run Text="{x:Bind ReactorDisplayNameBeforeText}"/><Span extensions:RichTextBlock.Html="{x:Bind ViewModel.Reblogger.DisplayName}"/><Run Text="{x:Bind ReactorDisplayNameAfterText}"/>
        </Paragraph>
    </RichTextBlock>

    <fluenticons:FluentIcon
        x:Name="ReactorIcon"
        x:Load="{x:Bind local:Converters.IsNotNull(ViewModel.Reblogger)}"
        Grid.Column="0"
        Grid.Row="0"
        Margin="0,4,0,-4"
        HorizontalAlignment="Right"
        Foreground="{ThemeResource TextFillColorTertiary}"
        FontSize="12"
        Icon="ArrowRepeatAll"/>

    <controls:Status
        x:Name="Status"
        Grid.Column="0"
        Grid.ColumnSpan="99"
        Grid.Row="1"
        Padding="8 8 8 8"
        BorderThickness="0 0 0 0.5"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        AvatarSize="40"
        AvatarScale="{x:Bind PosterAvatarScale}"
        DisplayNameFontSize="16"
        PostBodyLeftPadding="True"
        ViewModel="{x:Bind ViewModel.Content}"/>

    <Border
        x:Name="RebloggerAvatarBorder"
        x:Load="{x:Bind local:Converters.IsNotNull(ViewModel.Reblogger)}"
        Grid.Column="0"
        Grid.Row="1"
        VerticalAlignment="Top"
        HorizontalAlignment="Left"
        Margin="28, 28, 0, 0"
        IsHitTestVisible="False"
        Height="20"
        Width="20"
        CornerRadius="10">
        <Image extensions:Image.AutoPause="True">
            <Image.Source>
                <BitmapImage
                    x:Name="RebloggerAvatarBitmapImage"
                    UriSource="{x:Bind ViewModel.Reblogger.Avatar, Mode=OneWay}"/>
            </Image.Source>
        </Image>
    </Border>

    <Button
        x:Uid="Controls_Timeline_LoadMoreButton"
        x:Name="LoadMoreButton"
        x:Load="{x:Bind ViewModel.FollowedByGap}"
        Grid.Column="0"
        Grid.ColumnSpan="99"
        Grid.Row="2"
        Height="40"
        HorizontalAlignment="Stretch"
        Background="Transparent"
        BorderThickness="0 0 0 0.5"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        CornerRadius="0"/>
</Grid>
