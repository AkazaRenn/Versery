<?xml version="1.0" encoding="utf-8"?>
<RefreshContainer
    x:Class="View.Controls.Components.RefreshListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:View.Controls"
    xmlns:components="using:View.Controls.Components"
    xmlns:vm.controls="using:ViewModel.Controls"
    RefreshRequested="RefreshListView_RefreshRequested">
    <ListView
        x:Name="ListView"
        SelectionMode="None"
        ScrollViewer.VerticalScrollBarVisibility="Hidden"
        Loaded="ListView_Loaded"
        ContainerContentChanging="ListView_ContainerContentChanging">
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </ListView.ItemContainerStyle>
        <ListView.Footer>
            <Button
                x:Name="LoadMoreButton"
                x:Uid="Controls_Components_RefreshContainer_LoadMoreButton"
                Height="48"
                Foreground="{ThemeResource AccentTextFillColorSecondaryBrush}"
                FontWeight="Bold"
                BorderThickness="0"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                CornerRadius="0"
                Style="{StaticResource SubtleButtonStyle}">
                <components:SwitchContentPanel IsUsingDefaultContent="{x:Bind LoadMoreButton.IsEnabled, Mode=OneWay}">
                    <components:SwitchContentPanel.DefaultContent>
                        <TextBlock
                            x:Uid="Controls_Components_RefreshContainer_LoadMoreButton_TextBlock"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"/>
                    </components:SwitchContentPanel.DefaultContent>
                    <components:SwitchContentPanel.AlternateContent>
                        <ProgressRing IsActive="True" />
                    </components:SwitchContentPanel.AlternateContent>
                </components:SwitchContentPanel>
            </Button>
        </ListView.Footer>
    </ListView>
</RefreshContainer>
