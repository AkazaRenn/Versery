<?xml version="1.0" encoding="utf-8"?>
<Button
    x:Class="View.Controls.Components.TransparentButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:View"
    Background="{x:Bind local:Brushes.Transparent}">
    <Button.Resources>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#08FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#08000000"/>
    </Button.Resources>
</Button>
