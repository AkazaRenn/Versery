<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="View.Controls.Components.ImageButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:View.Controls.Components"
    xmlns:local="using:View">
    <Rectangle
        x:Name="ImageRectangle"
        Loaded="ImageRectangle_Loaded"
        Unloaded="ImageRectangle_Unloaded">
        <Rectangle.Fill>
            <ImageBrush
                x:Name="ImageBrush"
                Stretch="UniformToFill"
                AlignmentX="Center"
                AlignmentY="Center"/>
        </Rectangle.Fill>
    </Rectangle>
    <components:TransparentButton
        x:Name="Button"
        VerticalAlignment="Stretch"
        HorizontalAlignment="Stretch"
        BorderThickness="0"
        CornerRadius="0"
        Padding="0">
    </components:TransparentButton>
</Grid>
