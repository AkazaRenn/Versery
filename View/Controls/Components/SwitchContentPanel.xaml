<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="View.Controls.Components.SwitchContentPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:extensions="using:View.Extensions"
    xmlns:utilities="using:View.Utilities">
    <Border
        x:Name="DefaultContainer"
        Visibility="Visible"
        extensions:UIElement.FadeVisibility="True">
    </Border>
    <Border
        x:Name="AlternateContainer"
        Visibility="Collapsed"
        extensions:UIElement.FadeVisibility="True">
    </Border>
</Grid>
