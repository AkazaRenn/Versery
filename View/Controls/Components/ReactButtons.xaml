<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="View.Controls.Components.ReactButtons"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:View.Controls.Components"
    xmlns:fluenticons="using:FluentIcons.WinUI"
    xmlns:utilities="using:View.Utilities"
    ColumnDefinitions="Auto, *, Auto, *, Auto, *, Auto, *, Auto">
    <Button
        x:Name="ReplyButton"
        Grid.Column="0"
        Style="{StaticResource SubtleButtonStyle}"
        Padding="{x:Bind components:ReactButtons.ButtonPadding}">
        <fluenticons:FluentIcon
            Icon="Comment"
            FontSize="{x:Bind components:ReactButtons.FontSize}"
            RenderTransformOrigin="0.5, 0.5">
            <fluenticons:FluentIcon.RenderTransform>
                <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
            </fluenticons:FluentIcon.RenderTransform>
        </fluenticons:FluentIcon>
    </Button>
    <Button
        x:Name="ReblogButton"
        Grid.Column="2"
        Style="{StaticResource SubtleButtonStyle}"
        Padding="{x:Bind components:ReactButtons.ButtonPadding}">
        <Grid>
            <fluenticons:FluentIcon
                x:Name="ReblogIconInactive"
                Icon="{x:Bind components:ReactButtons.GetReblogIcon(ReblogButton.IsEnabled), Mode=OneWay}"
                FontSize="{x:Bind components:ReactButtons.FontSize}"
                OpacityTransition="{x:Bind utilities:Transitions.ScalarTransition}" />
            <fluenticons:FluentIcon
                x:Name="ReblogIconActive"
                Icon="ArrowRepeatAll"
                IconVariant="Filled"
                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                FontSize="{x:Bind components:ReactButtons.FontSize}"
                Opacity="0"
                OpacityTransition="{x:Bind utilities:Transitions.ScalarTransition}" />
        </Grid>
    </Button>
    <Button
        x:Name="FavouriteButton"
        Grid.Column="4"
        Style="{StaticResource SubtleButtonStyle}"
        Padding="{x:Bind components:ReactButtons.ButtonPadding}">
        <Grid>
            <fluenticons:FluentIcon
                x:Name="FavouriteIconInactive"
                Icon="Star"
                FontSize="{x:Bind components:ReactButtons.FontSize}"
                OpacityTransition="{x:Bind utilities:Transitions.ScalarTransition}" />
            <fluenticons:FluentIcon
                x:Name="FavouriteIconActive"
                Icon="Star"
                IconVariant="Filled"
                Foreground="{x:Bind utilities:Brushes.Orange}"
                FontSize="{x:Bind components:ReactButtons.FontSize}"
                Opacity="0"
                OpacityTransition="{x:Bind utilities:Transitions.ScalarTransition}" />
        </Grid>
    </Button>
    <Button
        Grid.Column="6"
        Style="{StaticResource SubtleButtonStyle}"
        Padding="{x:Bind components:ReactButtons.ButtonPadding}">
        <fluenticons:FluentIcon
            x:Name="ShareIcon"
            Icon="Share"
            FontSize="{x:Bind components:ReactButtons.FontSize}" />
    </Button>
    <Button
        Grid.Column="8"
        Style="{StaticResource SubtleButtonStyle}"
        Padding="{x:Bind components:ReactButtons.ButtonPadding}">
        <fluenticons:FluentIcon
            Icon="MoreHorizontal"
            FontSize="{x:Bind components:ReactButtons.FontSize}"
            RenderTransformOrigin="0.5, 0.5">
            <fluenticons:FluentIcon.RenderTransform>
                <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
            </fluenticons:FluentIcon.RenderTransform>
        </fluenticons:FluentIcon>
    </Button>
</Grid>