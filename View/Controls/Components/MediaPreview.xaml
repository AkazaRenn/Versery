<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="View.Controls.Components.MediaPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:View.Controls.Components">
    <components:ImageButton
        x:Name="ImageButton"
        Background="{x:Bind components:MediaPreview.DefaultBackground}">
        <components:ImageButton.ImageSource>
            <BitmapImage 
                x:Name="BitmapImage"
                AutoPlay="False"/>
        </components:ImageButton.ImageSource>
    </components:ImageButton>
</UserControl>
