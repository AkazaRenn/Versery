<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="View.Controls.Components.MediaPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:View.Controls.Components"
    Background="{x:Bind components:MediaPreview.GetBackground(BackgroundBlurHash)}">
    <Rectangle>
        <Rectangle.Fill>
            <ImageBrush
                Stretch="UniformToFill"
                AlignmentX="Center"
                AlignmentY="Center">
                <ImageBrush.ImageSource>
                    <BitmapImage x:Name="BitmapImage"/>
                </ImageBrush.ImageSource>
            </ImageBrush>
        </Rectangle.Fill>
    </Rectangle>
    <Border
        x:Name="Overlay"
        x:Load="{x:Bind components:MediaPreview.LoadOverlay(OverlayText)}"
        Background="#80000000">
        <TextBlock
            Foreground="White"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            FontSize="32"
            FontWeight="ExtraBold"
            Text="{x:Bind OverlayText}">
        </TextBlock>
    </Border>
</Grid>
