<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="View.Controls.Components.MediaPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:View.Controls.Components">
    <components:ButtonWithImage 
        x:Name="ButtonWithImage"
        Background="{x:Bind components:MediaPreview.GetBackground(BackgroundBlurHash)}">
        <components:ButtonWithImage.ImageSource>
            <BitmapImage x:Name="BitmapImage"/>
        </components:ButtonWithImage.ImageSource>
    </components:ButtonWithImage>
</UserControl>
