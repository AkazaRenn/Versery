<?xml version="1.0" encoding="utf-8"?>
<Grid
    x:Class="View.Controls.Components.MediaGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluenticons="using:FluentIcons.WinUI"
    xmlns:utilities="using:View.Utilities"
    Loaded="Grid_Loaded"
    Unloaded="Grid_Unloaded">
    <Grid
        x:Name="Tiles"
        ColumnSpacing="{x:Bind ColumnSpacing, Mode=OneWay}"
        RowSpacing="{x:Bind RowSpacing, Mode=OneWay}"/>
    <Button
        x:Name="ToggleMediaPreviewsButton"
        VerticalAlignment="Top"
        HorizontalAlignment="Left"
        Margin="4,4,0,0"
        Padding="4">
        <Grid>
            <fluenticons:FluentIcon
                x:Name="HiddenIcon"
                Icon="EyeOff"
                FontSize="20"
                Opacity="0"
                OpacityTransition="{x:Bind utilities:Transitions.ScalarTransition}"/>
            <fluenticons:FluentIcon
                x:Name="VisibleIcon"
                Icon="Eye"
                FontSize="20"
                OpacityTransition="{x:Bind utilities:Transitions.ScalarTransition}"/>
        </Grid>
        <Button.Background>
            <SolidColorBrush Color="{ThemeResource SystemAltHighColor}" Opacity="0.5"/>
        </Button.Background>
        <Button.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                Color="{ThemeResource SystemAltHighColor}" Opacity="0.45"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed"
                Color="{ThemeResource SystemAltHighColor}" Opacity="0.55"/>
        </Button.Resources>
    </Button>
</Grid>
