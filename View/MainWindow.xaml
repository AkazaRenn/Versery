<?xml version="1.0" encoding="utf-8"?>
<winex:WindowEx
    x:Class="View.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winex="using:WinUIEx"
    xmlns:controls="using:View.Controls"
    xmlns:pages="using:View.Pages"
    xmlns:extensions="using:View.Extensions"
    Title="MainWindow"
    MinWidth="300"
    MinHeight="400">

    <winex:WindowEx.SystemBackdrop>
        <MicaBackdrop/>
    </winex:WindowEx.SystemBackdrop>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="UserProfileColumn" Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <NavigationView
            x:Name="Navigation"
            Grid.Column="0"
            Grid.Row="0"
            PaneDisplayMode="Top"
            IsBackButtonVisible="Visible"
            IsSettingsVisible="False"
            ItemInvoked="Navigation_ItemInvoked"
            BackRequested="Navigation_BackRequested"
            SizeChanged="Navigation_SizeChanged"
            Loaded="Navigation_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Uid="MainWindow_NavigationViewItem_Home"
                    Tag="{x:Bind pages:Home.Type}"/>
                <NavigationViewItem
                    x:Uid="MainWindow_NavigationViewItem_Notifications"
                    Tag="{x:Bind pages:SignIn.Type}"/>
            </NavigationView.MenuItems>
        </NavigationView>
        <Border
            Grid.Column="1"
            Grid.Row="0"
            Width="{x:Bind UserProfileButtonSize}"
            Height="{x:Bind UserProfileButtonSize}"
            CornerRadius="{x:Bind UserProfileButtonCornerRadius}"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
            <Image extensions:Image.AutoPause="True">
                <Image.Source>
                    <BitmapImage UriSource="{x:Bind viewModel.Avatar, Mode=OneWay}"/>
                </Image.Source>
            </Image>
        </Border>
        <controls:UserProfileButton
            x:Name="UserProfileButton"
            Grid.Column="1"
            Grid.Row="0"
            Width="{x:Bind UserProfileButtonSize}"
            Height="{x:Bind UserProfileButtonSize}"
            CornerRadius="{x:Bind UserProfileButtonCornerRadius}"
            Padding="0"
            BorderThickness="0"
            Background="Transparent"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"/>
        <Frame
            x:Name="Frame"
            Grid.Column="0"
            Grid.ColumnSpan="99"
            Grid.Row="1"
            Navigated="Frame_Navigated"/>
    </Grid>
</winex:WindowEx>
