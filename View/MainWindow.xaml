<?xml version="1.0" encoding="utf-8"?>
<winex:WindowEx
    x:Class="View.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winex="using:WinUIEx"
    xmlns:controls="using:View.Controls"
    xmlns:pages="using:View.Pages"
    xmlns:extensions="using:View.Extensions"
    Title="Versery"
    MinWidth="300"
    MinHeight="400">

    <winex:WindowEx.SystemBackdrop>
        <MicaBackdrop/>
    </winex:WindowEx.SystemBackdrop>

    <Grid RowDefinitions="Auto, *">
        <NavigationView
            x:Name="Navigation"
            Grid.Row="0"
            PaneDisplayMode="Top"
            IsBackButtonVisible="Visible"
            IsSettingsVisible="False"
            ItemInvoked="Navigation_ItemInvoked"
            BackRequested="Navigation_BackRequested"
            SizeChanged="Navigation_SizeChanged"
            Loaded="Navigation_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Uid="MainWindow_NavigationViewItem_Home"
                    Tag="{x:Bind pages:Home.Type}"/>
                <NavigationViewItem
                    x:Uid="MainWindow_NavigationViewItem_Notifications"
                    Tag="{x:Bind pages:SignIn.Type}"/>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItemHeader
                    x:Name="Navigation_RightPadding"/>
            </NavigationView.FooterMenuItems>
        </NavigationView>
        <controls:UserProfileButton
            x:Name="UserProfileButton"
            Grid.Row="0"
            Width="40"
            Height="40"
            CornerRadius="20"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            AvatarUri="{x:Bind viewModel.Avatar, Mode=OneWay}"/>
        <Frame
            x:Name="Frame"
            Grid.Row="1"
            Background="{ThemeResource NavigationViewContentBackground}"
            Navigated="Frame_Navigated"/>
    </Grid>
</winex:WindowEx>
