<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Model</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluentSettings.Generator" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Refit" />
    <PackageReference Include="ZoneTree" />
  </ItemGroup>

  <!-- Refitter: regenerates Server\Generated from the Mastodon OpenAPI spec on every build. -->
  <PropertyGroup>
    <RefitterNoLogging>true</RefitterNoLogging>
    <RefitterJsonLibraryVersion>$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)'))</RefitterJsonLibraryVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Refitter.MSBuild" PrivateAssets="all" />
    <UpToDateCheckInput Include="Server\Mastodon.refitter;..\Dependency\mastodon-openapi\dist\schema.json" />
    <Compile Remove="Server\Generated\**" />
  </ItemGroup>
</Project>
