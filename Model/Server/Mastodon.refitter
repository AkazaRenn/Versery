{
  "openApiPath": "../../Dependency/mastodon-openapi/dist/schema.json",
  "namespace": "Model.Server",
  "contractsNamespace": "Model.Server.Entities",
  "outputFolder": "./Generated",
  "contractsOutputFolder": "./Generated",
  "generateMultipleFiles": true,
  "multipleInterfaces": "ByTag",
  "useCancellationTokens": true,
  "optionalParameters": true,
  "generateJsonSerializerContext": true,
  "generateDefaultAdditionalProperties": false,
  "codeGeneratorSettings": {
    "generateNullableReferenceTypes": true,
    "generateOptionalPropertiesAsNullable": true,
    "generateNativeRecords": true,
    "excludedTypeNames": [ "OAuthScopes" ]
  }
}
